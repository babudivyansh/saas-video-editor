  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-test-renderer": "19.2.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
