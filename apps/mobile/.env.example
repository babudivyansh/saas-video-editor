# Copy to .env.local (gitignored). Expo inlines EXPO_PUBLIC_* into the bundle
# at build time, so these are public by design: never put a secret here.

# The Clipiro server. Unset: a dev build uses http://10.0.2.2:3000 (the host's
# `next dev`, as the Android emulator sees it); a release build, https://clipiro.com.
# On a physical phone, use your computer's LAN address, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_API_URL=

# Google sign-in: the WEB OAuth client ID (the server's GOOGLE_CLIENT_ID), not
# the Android one. Google also needs an Android OAuth client in the same Cloud
# project for package com.clipiro.app + this build's signing SHA-1, or the
# picker fails with DEVELOPER_ERROR. Unset: the Google button says it isn't set up.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
