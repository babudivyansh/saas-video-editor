# PostgreSQL — local dev defaults (point this at any reachable instance)
DATABASE_URL="postgresql://saas:saas@localhost:5432/saas_video"

# Redis — local dev defaults (optional: falls back to in-memory if unreachable)
REDIS_URL="redis://localhost:6379"

# Google Gemini AI — used by: AI Brainstormer, AI Image Generator (Imagen 3)
GEMINI_API_KEY=""

# ElevenLabs TTS
ELEVENLABS_API_KEY=""
# Ceiling on total cloned voices across ALL users (the ElevenLabs account's
# voice-slot limit is shared, not per-user). Default 100 if unset — raise to
# match the actual ElevenLabs plan.
ELEVENLABS_MAX_VOICE_SLOTS=""

# AWS S3 — stores generated images & voiceovers. Required by AI Image Generator
# and AI Voiceover. AWS_REGION MUST match the region your bucket was created in
# (e.g. ap-south-1) — a mismatch makes every upload/URL fail even with valid keys.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"

# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# Google Sign-In (OAuth) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (must match exactly, no trailing slash):
#   ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Twilio — real OTP SMS delivery (https://console.twilio.com)
# Without these, OTP is dev-stubbed (printed to server console only)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Email — OTP / transactional email (any SMTP provider, e.g. Gmail, SendGrid, Resend)
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# Resend API key (optional, but strongly preferred over raw SMTP above).
# lib/email/send.ts tries Resend first, falls back to SMTP, then falls back to
# just logging the mail in dev. Without this AND without EMAIL_USER, no email is
# ever actually delivered — which silently breaks the newsletter double opt-in
# flow, since the confirmation link is the only way to subscribe. That state is
# now reported as SendResult.status === "dev-logged" rather than as success.
RESEND_API_KEY=""

# Resend webhook signing secret ("whsec_…"), from https://resend.com/webhooks.
# Point the hook at /api/webhooks/resend and subscribe to email.bounced,
# email.complained and email.delivered.
#
# Without it that endpoint rejects every request, which is the correct failure
# mode: an unverified webhook could suppress any address an attacker names.
# Without the hook configured at all, hard bounces and spam complaints are never
# recorded and dead addresses get retried by every cron forever — the fastest
# way to lose sending reputation.
RESEND_WEBHOOK_SECRET=""

# Where images inside emails are loaded from. Defaults to https://clipiro.com.
# Deliberately separate from NEXT_PUBLIC_APP_URL: links must follow the
# deployment so staging links go to staging, but a staging or preview build
# still needs the logo to resolve to a host a mail client can actually reach.
EMAIL_ASSET_BASE_URL=""

# Backgrounds CDN (optional) — override the default S3 base URL for background videos
# Default: https://saas-video-editor-assets.s3.ap-south-1.amazonaws.com/backgrounds
NEXT_PUBLIC_BACKGROUNDS_BASE=""

# fal.ai — AI video generation (VEO3, Hailuo, Seedance) + AI Creator (SadTalker lip-sync)
# Get key at https://fal.ai/dashboard/keys
FAL_KEY=""

# AI Creator preset avatars (optional) — set to public S3 URLs of face images you want
# to use as preset options. If left empty, users must upload their own face image.
PRESET_AVATAR_NANO_BANANA_URL=""
PRESET_AVATAR_FACE_SWAP_URL=""

# Stock content in the editor's Image/Video/Audio/Sticker tabs. Each panel
# shows "not configured" until its key is set — none are required for the
# rest of the app to work.
PEXELS_API_KEY=""       # stock photos + stock video — https://www.pexels.com/api/
JAMENDO_CLIENT_ID=""    # CC-licensed stock music   — https://developer.jamendo.com/
GIPHY_API_KEY=""        # stickers                  — https://developers.giphy.com/

# Cron / scheduled jobs — required in production. Each cron route rejects every
# request unless the Authorization header matches "Bearer <secret>", so leaving
# these unset does NOT make the route open — it makes it permanently 401.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""            # guards refill-credits, account-purge, onboarding,
                          # reengagement, review-drip, review-prompts,
                          # subscription-reminder, clip-publish (scheduled
                          # AutoClip posting) — see SETUP.md §7 for the full list
SOCIAL_REFRESH_SECRET=""  # guards social-refresh and admin-digest
ASSET_CLEANUP_SECRET=""   # guards GET /api/cron/asset-cleanup

# CDN prep for the Assets library (optional) — unset means asset reads use S3
# presigned URLs directly. Set only after provisioning a CloudFront
# distribution (with Origin Access Control on AWS_S3_BUCKET) in front of it.
CDN_BASE_URL=""

# ScrapeCreators — public-data vendor for Social Tracker competitor benchmarking
# (lib/social/competitor-source.ts). The competitor section stays hidden until
# SCRAPECREATORS_API_KEY is set. SOCIAL_COMPETITOR_MONTHLY_BUDGET caps vendor
# requests/month (default 300) so refreshes pause instead of running up a bill.
SCRAPECREATORS_API_KEY=""
SOCIAL_COMPETITOR_MONTHLY_BUDGET=""

# Render job queue driver (optional). NOTE the direction: the code is
#   `if (env.RENDER_QUEUE_DRIVER !== "in-process") { use BullMQ }`
# so UNSET means BullMQ (durable, survives restarts), and the ONLY value that
# selects the in-process queue is the literal "in-process". This comment
# previously described the opposite and was wrong.
#
# If production is observed running the in-process driver with this unset,
# BullMQ failed to initialise and createRenderQueue fell back — grep the logs
# for "BullMQ init failed", which almost always means Redis is unreachable.
# In-process means jobs in flight die with the process.
RENDER_QUEUE_DRIVER=""

# How many clips of one AutoClip batch render concurrently (optional,
# default 3). Each render is itself multi-threaded ffmpeg, so this is a small
# number — raise it only if the box has cores to spare.
RENDER_CLIP_CONCURRENCY=""

# Per-stage AutoClip pipeline metrics (lib/pipeline-metrics.ts). On by default;
# set to "off" to stop emitting them without a deploy, e.g. if the Redis
# instance is under command-quota pressure.
PIPELINE_METRICS=""

# GPU media service — active-speaker detection + NVENC rendering
# (gpu-service/README.md). ALL THREE OPTIONAL: with GPU_SERVICE_URL unset the
# GPU path is inert and every caller uses CPU, which is a fully supported
# configuration. Verify a configured service with `npm run check:gpu`.
GPU_SERVICE_URL=""        # e.g. https://api.runpod.ai/v2/<endpoint-id>
GPU_SERVICE_TOKEN=""      # shared HMAC secret; must match the container's env
GPU_SERVICE_API_KEY=""    # provider API key (RunPod); omit when self-hosting

# Next.js public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Official social media handles (footer links). NEXT_PUBLIC_ = baked into the
# browser bundle at build time, so a rebuild/redeploy is required after changes.
NEXT_PUBLIC_DISCORD_INVITE_URL="https://discord.gg/F7jftK3fxe"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/clipiroapp/"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/profile.php?id=61593101997903"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/109881774"
NEXT_PUBLIC_X_URL="https://x.com/ClipiroOfficial"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/@clipiroofficial"

# Sentry error tracking (optional) — leave unset to disable entirely.
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser bundle by design.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Needed only to upload source maps at build time; safe to leave unset.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
