# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local agent tooling
.claude/

# generated test output (may contain auth tokens)
scripts/e2e-results.json

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# design-sync (claude.ai/design) — staged converter + generated build output
/.ds-sync/
/ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Generated by scripts/preview-emails.ts
.email-preview/

# AutoClip E2E harness fixtures + downloaded renders (scripts/autoclip-e2e.ts)
/.e2e-tmp/

# local scratch/test output
/scratch/


# Pinned render runtime — downloaded and SHA-256 verified by
# scripts/install-render-ffmpeg.mjs at install time. ~80MB executable;
# never commit it (see docs/editor-release-gate-stage1-production-verification.md).
/vendor/
