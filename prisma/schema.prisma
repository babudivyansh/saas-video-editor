generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  phone                String?         @unique
  passwordHash         String
  // Denormalized TOTAL balance = bonus + subscription + purchased, maintained
  // atomically by lib/credits.ts in the same statement as every bucket
  // mutation (2026-07 bucket split). Read-only everywhere else — all existing
  // balance reads (auth payloads, admin dashboards) keep working off this.
  credits              Int             @default(0)
  // Credit buckets. Spend order: bonus -> subscription -> purchased (see
  // lib/credits.ts spendCredits). Subscription credits roll over up to 2x the
  // monthly grant and are zeroed on lapse; purchased (pack) credits never
  // expire; bonus credits expire at bonusCreditsExpireAt.
  subscriptionCredits  Int             @default(0)
  purchasedCredits     Int             @default(0)
  bonusCredits         Int             @default(0)
  bonusCreditsExpireAt DateTime?
  // Free-tier monthly grant anchor: users without an active plan get a small
  // bonus-credit refill each month (cron step 4). Null for subscribers.
  freeCreditsRefillAt  DateTime?
  // ── Razorpay Subscriptions (true recurring billing, 2026-07) ──
  // Null = legacy prepaid subscriber (one-time orders; cron-refilled).
  // Set = renewals arrive via the subscription.charged webhook.
  razorpaySubscriptionId String?    @unique
  razorpayCustomerId     String?
  // 7-day Pro trial: once per account, card-authorized upfront.
  trialUsedAt            DateTime?
  trialEndsAt            DateTime?
  // Set when the user requests cancel-at-cycle-end (POST /api/billing/cancel).
  // Access continues until subscriptionEndsAt regardless — this only marks
  // intent so the billing UI shows "Cancelled — access until {date}" instead
  // of offering Cancel again. Cleared whenever a subscription (re)activates
  // (subscription.activated webhook) or lapses (refill-credits cron).
  subscriptionCancelledAt DateTime?
  // Opt-in auto top-up (2026-07 audit): when set, a spend that leaves the
  // balance under the threshold triggers lib/credits.ts's maybeAutoTopup —
  // a debounced attempt to purchase this pack (one-click email in practice;
  // see lib/email.ts sendAutoTopupPromptEmail and the RBI-mandate note there).
  autoTopupPackSlug      String?
  role                 Role            @default(USER)
  firstName            String?
  lastName             String?
  name                 String?
  avatarUrl            String?
  gender               String? // "male" | "female" | "unspecified" — validated in the API layer
  intendedUse          String? // "content_creator" | "business_marketing" | "personal" | "other" — validated in the API layer
  preferredLanguage    String          @default("en") // ISO 639-1 code — validated against lib/i18n-locales.ts's supported-locale list in the API layer
  planId               String?
  plan                 Plan?           @relation(fields: [planId], references: [id])
  // Subscription state (Phase C)
  subscriptionId       String? // Razorpay subscription/order id for the active term
  subscriptionEndsAt   DateTime? // when the prepaid term expires (null = no active sub)
  nextRefillAt         DateTime? // when the next monthly credit grant is due
  monthlyCredits       Int             @default(0) // credits granted on each refill for the active tier
  // Affiliate program
  referredBy           String? // affiliateId that referred this user
  // Email lifecycle tracking
  lastLoginAt          DateTime? // updated on every successful login
  firstVideoAt         DateTime? // set on first successful render — triggers upsell email
  lowCreditEmailSentAt DateTime? // reset each monthly refill; prevents duplicate low-credit alerts
  expiryReminderSentAt DateTime? // tracks which expiry email (7d/3d/1d) was last sent
  reengagementSentAt   DateTime? // prevents duplicate re-engagement emails
  onboardingDay1SentAt DateTime?
  onboardingDay3SentAt DateTime?
  onboardingDay7SentAt DateTime?
  onboardingCompletedAt DateTime? // set once the welcome screen is completed or skipped — never shown again after
  primaryGoal          String? // "auto-clip" | "image" | "video" | "voiceover" | "editor" — picked on the welcome screen, validated in the API layer
  experienceLevel      String? // "beginner" | "intermediate" | "advanced" — validated in the API layer
  teamOrIndividual     String? // "individual" | "team" — validated in the API layer
  tourStep             Int? // current guided-tour step index; null once never started
  tourCompletedAt      DateTime? // set once the guided tour is completed or skipped
  dismissedHints       String[]        @default([]) // ids of FeatureHint cards the user has dismissed — never shown again
  // Admin moderation (Phase 3): a suspended user fails auth on every request
  // (lib/auth.ts getAuthUser) until un-suspended. Soft alternative to deletion.
  suspendedAt          DateTime?
  adminNotes           String? // free-form internal notes, admin console only — never exposed to the user

  // Email verification / change. email itself flips only once the pending
  // address is confirmed (see app/api/auth/change-email/confirm) — never
  // swapped eagerly.
  emailVerifiedAt      DateTime?
  pendingEmail         String?

  // Password/session security
  passwordChangedAt    DateTime? // set on every successful change-password; used by the account-dashboard security score

  // Two-factor authentication (TOTP, RFC 6238). Secret is AES-256-GCM
  // ciphertext (lib/encryption.ts) — never stored or returned as plaintext.
  twoFactorEnabled     Boolean         @default(false)
  twoFactorSecretEnc   String?
  // Highest 30s time-step already spent on a successful verification. A TOTP
  // code stays valid for its whole ±1-step window (~90s), so without this a
  // code captured over the shoulder or through a phishing proxy can be
  // replayed; rejecting any step <= this one makes every code single-use.
  // Int is safe: the step is unix-seconds/30, ~58M today against a 2.1B
  // ceiling.
  twoFactorLastUsedStep Int?
  recoveryCodes        TwoFactorRecoveryCode[]

  // Soft account deactivation — a recovery window before the existing hard-delete
  // flow (DELETE /api/auth/profile) runs. Login is blocked while deactivatedAt is set.
  deactivatedAt              DateTime?
  deactivationScheduledPurgeAt DateTime?

  notificationPreference NotificationPreference?

  createdAt            DateTime        @default(now())
  projects             Project[]
  assets               Asset[]
  purchases            Purchase[]
  creditTransactions   CreditTransaction[]
  quests               UserQuest[]
  questRewardClaimed   Boolean         @default(false)
  affiliate            Affiliate?
  referral             Referral?       @relation("ReferredByAffiliate")
  socialAccounts       SocialAccount[]
  competitors          CompetitorProfile[]
  generations          Generation[]
  loginEvents          LoginEvent[]
  apiKeys              ApiKey[]
  brandKits            BrandKit[]
  assetFolders         AssetFolder[]
  tags                 Tag[]
  assetAuditLogs       AssetAuditLog[]
  pendingUploads       PendingUpload[]
}

// One-time hashed 2FA recovery code — issued 10-at-a-time on enrollment,
// each usable exactly once as a TOTP fallback (lost authenticator device).
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Per-user opt-out flags for non-critical email categories. Absence of a row
// means "all defaults (on)" — created lazily on first read/write, not at
// signup, so most users never get a row until they actually touch this page.
// Security-critical mail (new-login alert, password-changed, email-changed,
// purchase confirmation) is NEVER gated by this table — see lib/notifications.ts.
model NotificationPreference {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingEmails Boolean  @default(true)
  productUpdates  Boolean  @default(true)
  usageAlerts     Boolean  @default(true)
  creditAlerts    Boolean  @default(true)
  weeklySummary   Boolean  @default(true)
  featureReleases Boolean  @default(true)
  newsletter      Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// One row per successful login (Phase 3) — powers the admin user-detail login
// history and, over time, device/country analytics. The login route already
// computed device + geo transiently for the sign-in alert email; now it also
// persists them.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  device    String?
  country   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Affiliate {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  code           String       @unique
  status         String       @default("active") // active | suspended | banned
  commissionRate Float        @default(0.20)
  totalEarned    Float        @default(0)
  totalPaid      Float        @default(0)
  // Null = never expires (true of every code issued so far). Lets "expired"
  // be a real, testable rejection reason for the sign-up referral-code field
  // (see lib/affiliate.ts resolveReferralCode) instead of unreachable.
  codeExpiresAt  DateTime?
  createdAt      DateTime     @default(now())
  referrals      Referral[]
  commissions    Commission[]
}

model Referral {
  id             String       @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate    @relation(fields: [affiliateId], references: [id])
  referredUserId String       @unique
  referredUser   User         @relation("ReferredByAffiliate", fields: [referredUserId], references: [id])
  status         String       @default("signed_up") // signed_up | converted | flagged | fraudulent
  signupIp       String?
  signedUpAt     DateTime     @default(now())
  convertedAt    DateTime?
  commissions    Commission[]

  @@index([affiliateId])
}

model Commission {
  id              String    @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])
  referralId      String
  referral        Referral  @relation(fields: [referralId], references: [id])
  razorpayOrderId String?
  baseAmount      Float
  commissionRate  Float
  amount          Float
  status          String    @default("pending") // pending | available | paid | rejected
  createdAt       DateTime  @default(now())
  availableAt     DateTime
  paidAt          DateTime?
  payoutRef       String?
  payoutEmailSent Boolean   @default(false) // prevents duplicate "commission available" emails

  @@index([affiliateId])
  @@index([referralId])
}

model Plan {
  id             String     @id @default(uuid())
  slug           String     @unique
  name           String
  priceInPaise   Int
  currency       String     @default("INR")
  credits        Int
  features       String[]   @default([])
  active         Boolean    @default(true)
  sortOrder      Int        @default(0)
  // Plan type (Phase C). "pack" = one-time top-up (subscriber-only),
  // "subscription" = recurring tier with monthly credit refills.
  kind           String     @default("pack")
  // Razorpay Plan ids for the recurring Subscriptions flow, per currency.
  // Provisioned by scripts/razorpay-sync-plans.ts; null until synced (the
  // legacy one-time order flow keeps working for unsynced plans).
  razorpayPlanIdInr String?
  razorpayPlanIdUsd String?
  intervalMonths Int?// subscription term length: 1 / 3 / 6 / 12
  monthlyCredits Int? // credits granted each month of the term
  // "creator" | "pro" | "studio" — meaningful only when kind == "subscription";
  // null for pack/addon rows. See lib/plans/tiers.ts for the TierId union and
  // gating helpers. "free" is not a Plan row — it's the sentinel tier for a
  // user with no active subscription.
  tier           String?
  createdAt      DateTime   @default(now())
  users          User[]
  purchases      Purchase[]
}

model Purchase {
  id            String   @id
  userId        String
  // Restrict, not Cascade: a Purchase row is a financial/audit record and must
  // never be silently destroyed by deleting the user it belongs to. Both
  // DELETE /api/auth/profile and the admin user-delete route explicitly check
  // for purchase history and refuse the delete with a clear message instead.
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId        String?
  plan          Plan?    @relation(fields: [planId], references: [id])
  amountInPaise Int
  credits       Int
  status        String   @default("captured")
  createdAt     DateTime @default(now())

  // Admin dashboards aggregate purchases by day and by (status, window)
  // constantly — these keep the metrics endpoint fast as rows grow.
  @@index([createdAt])
  @@index([status, createdAt])
}

// Admin-created discount codes applied at checkout. The discount lowers the
// Razorpay order amount only — credits granted are always based on the plan.
model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique // stored UPPERCASE
  description       String?
  discountType      String             @default("percent") // "percent" | "fixed"
  discountValue     Int // percent 1–100, or paise for fixed
  appliesTo         String             @default("all") // "all" | "subscription" | "pack"
  planSlugs         String[]           @default([]) // optional: restrict to specific plan slugs
  minAmountInPaise  Int                @default(0)
  maxRedemptions    Int? // null = unlimited
  perUserLimit      Int                @default(1)
  timesRedeemed     Int                @default(0)
  firstPurchaseOnly Boolean            @default(false)
  featured          Boolean            @default(false) // surfaced on the billing launch banner
  active            Boolean            @default(true)
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  redemptions       CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  orderId         String?
  discountInPaise Int
  createdAt       DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

model Project {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  script               String   @default("")
  voiceId              String   @default("")
  musicUrl             String?
  backgroundUrl        String   @default("")
  subtitlesStyle       Json     @default("{}")
  status               String   @default("draft")
  progress             Int      @default(0) // 0–100 render progress for polling
  videoUrl             String?
  uploadedVideoUrl     String?
  productType          String   @default("split-screen")
  editorDoc            Json? // browser-editor timeline document (productType "editor")
  // Auto Clip: default caption style applied to newly-picked clips (index into
  // lib/caption-styles.ts CAPTION_STYLES; -1 = captions off). See lib/render/auto-clip.
  autoClipCaptionStyle Int?
  // Auto Clip: non-fatal problems surfaced to the user as a banner instead of
  // silently degrading (e.g. ["transcription_failed"]).
  warnings             Json?
  faceTimeline         Json?
  createdAt            DateTime @default(now())
  clips                Clip[]

  @@index([userId])
  @@index([userId, status])
}

// An individual clip produced by Auto Clip. The pick job creates one row per
// AI-picked segment (status "pending_review"); the user reviews/edits picks,
// then confirming moves kept clips to "queued" and renders + uploads each
// separately so the UI can show every clip as its own card with live progress
// and an Opus-style virality score.
model Clip {
  id                String        @id @default(cuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index             Int // generation order
  title             String? // AI-generated catchy title / hook
  startSec          Float
  endSec            Float
  durationSec       Float
  aspectRatio       String        @default("9:16")
  score             Int? // calibrated virality 0–99, see lib/virality-score.ts
  rerenderCount     Int           @default(0) // first re-render per clip is free; charged after that
  scoreBreakdown    Json? // {hook, pacing, payoff, engagement, audio, speechRate} sub-scores for transparency
  mood              String? // AI-detected content mood, drives auto color grade (P2.3)
  status            String        @default("queued") // pending_review | queued | rendering | ready | failed
  progress          Int           @default(0) // 0–100
  videoUrl          String?
  thumbnailUrl      String?
  // Captioning (P0.3) — transcript is sliced/re-baselined to this clip's own
  // timeline so re-render (P1.3) never needs to re-run STT.
  transcriptJson    Json?
  captionStyleIndex Int?
  hasCaptions       Boolean       @default(false)
  // Speaker-tracking reframe (P1.1) — smoothed crop path in source-pixel
  // coordinates, [{tSec, x, y, w, h}]. Null = static center crop (fallback).
  cropKeyframes     Json?
  // Auto B-roll (P2.3) — a Pexels stock clip spliced in for [brollStartSec,
  // brollEndSec) (clip-relative) while the original audio continues. Null
  // brollUrl = no B-roll for this clip (Gemini found no natural opportunity,
  // clip too short, or Pexels unavailable/unconfigured).
  brollQuery        String?
  brollUrl          String?
  brollStartSec     Float?
  brollEndSec       Float?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt // stale-clip sweep reads this — see lib/cron/stale-clip-sweep.ts
  subtitleStyleOverride Json?
  silenceSettings       Json?
  dubs                  ClipDub[]
  publishes             ClipPublish[]

  @@index([projectId])
  @@index([projectId, status])
}

// A dubbed-audio variant of a Clip in another language (P2.2). Captions stay
// in the source language for v1 — re-aligning captions to dubbed audio would
// require re-running STT on the dub, deferred as a known limitation shared by
// several competitors.
model ClipDub {
  id         String   @id @default(cuid())
  clipId     String
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  targetLang String
  status     String   @default("dubbing") // dubbing | ready | failed
  videoUrl   String?
  createdAt  DateTime @default(now())

  @@index([clipId])
}

// A publish record linking a Clip to a connected SocialAccount. Actually
// pushing new video content to YouTube/Instagram/Facebook needs write-scope
// OAuth grants this app doesn't request today (SocialAccount is read-only
// analytics per its own doc comment) plus platform app review — out of scope
// to silently wire up. This model instead tracks "I posted this externally"
// (user pastes the permalink after manually publishing) so the existing
// social-refresh sync can pull real performance data back onto the clip,
// closing the analytics loop without requiring new OAuth scopes.
model ClipPublish {
  id              String        @id @default(cuid())
  clipId          String
  clip            Clip          @relation(fields: [clipId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  providerPostId  String? // set once the user links the live post/permalink
  permalink       String?
  status          String        @default("pending") // pending | linked | failed
  metricsJson     Json? // cached NormalizedPost-shaped snapshot, refreshed by lib/social/refresh-queue.ts
  scheduledFor    DateTime?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([clipId])
  @@index([socialAccountId])
}

model RazorpayEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
}

// Append-only ledger of every credit balance change, per bucket. Written
// exclusively by lib/credits.ts (grantCredits/spendCredits/refundSpend and
// the cron's cap/lapse/expiry steps). refId ties spend rows to a Generation
// id (or grant rows to a Razorpay payment id) so refunds can reverse exactly
// the buckets a spend drained.
model CreditTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket    String // "bonus" | "subscription" | "purchased"
  delta     Int // positive = grant, negative = spend/expire
  reason    String // "spend:<toolSlug>" | "grant:pack" | "grant:refill" | "refund" | "expire" | "lapse" | ...
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([refId])
}

// Key-value store for runtime admin configuration (e.g. tool enable/disable, credit costs).
model Config {
  key   String @id
  value String // JSON string
}

model UserQuest {
  id          String   @id @default(uuid())
  userId      String
  questId     String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model Asset {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  s3Key    String
  url      String // legacy permanent URL, kept for rows created before signed URLs; reads now resolve a fresh presigned URL from s3Key instead of trusting this column
  mimeType String
  kind     String // "video" | "audio" | "image"
  size     Int
  duration Float?
  width    Int?
  height   Int?

  // Organization (folders/tags/favorites/archive)
  folderId   String?
  folder     AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  isFavorite Boolean      @default(false)
  archivedAt DateTime? // soft-delete: set on Archive, cleared on Restore, hard-deleted by the cleanup cron after the retention window
  tags       AssetTag[]

  // Thumbnails — a lightweight extracted frame/preview so the grid never has
  // to stream the full source file just to render a card.
  thumbnailS3Key String?

  // Duplicate detection — SHA-256 of the uploaded bytes, computed server-side.
  checksum String?

  // Moderation (Rekognition DetectModerationLabels, async via the
  // asset-moderation queue). "not_configured" is reserved for the malware-scan
  // step, which has no vendor wired up yet — it is never silently marked "clean".
  moderationStatus String  @default("pending") // "pending" | "clean" | "flagged" | "skipped" | "not_configured"
  moderationLabels Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AssetAuditLog[]

  @@unique([userId, checksum])
  @@index([userId, createdAt])
  @@index([userId, kind])
  @@index([userId, archivedAt])
  @@index([folderId])
}

// Flat (non-nested) per-user folder for organizing assets.
model AssetFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@unique([userId, name])
  @@index([userId])
}

// Reusable per-user tag — a real row (not a denormalized string array) so the
// UI can list/autocomplete/rename a user's whole tag vocabulary.
model Tag {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  assets    AssetTag[]

  @@unique([userId, name])
  @@index([userId])
}

model AssetTag {
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId])
}

// Per-user history of asset actions (upload/rename/delete/archive/restore/
// bulk-*/moderation-flag) — the user-facing counterpart to lib/admin/audit.ts.
model AssetAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([assetId])
}

// Written right before the S3 PUT and deleted right after a successful
// Asset.create — lets the cleanup cron find orphaned S3 objects (upload
// succeeded, DB insert didn't) without an expensive bucket ListObjects scan.
model PendingUpload {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  s3Key             String
  // Set only for a client-driven S3 multipart upload (large files) — lets the
  // cleanup cron abort the incomplete multipart upload (AbortMultipartUpload)
  // instead of trying DeleteObject on a key that was never a real object.
  multipartUploadId String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// A social platform account a user has linked via OAuth (Social Tracker).
// OAuth tokens are stored ONLY as AES-256-GCM ciphertext (lib/encryption.ts) and
// are never returned to the client. Read-only analytics scopes only.
model SocialAccount {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "youtube" | "instagram" | "facebook"
  providerAccountId String // channel id / IG user id / Page id
  username          String?
  displayName       String?
  avatarUrl         String?
  accessTokenEnc    String // AES-256-GCM ciphertext
  refreshTokenEnc   String? // AES-256-GCM ciphertext
  tokenExpiresAt    DateTime?
  scopes            String[]                @default([])
  status            String                  @default("active") // active | needs_reauth | revoked
  followers         Int? // convenience copy of the latest snapshot
  lastSyncedAt      DateTime?
  lastSyncStatus    String                  @default("ok") // ok | partial | failed
  lastSyncError     String? // human-readable reason when partial/failed
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  posts             SocialPost[]
  snapshots         SocialAccountSnapshot[]
  audience          SocialAudienceSnapshot[]
  insights          AiInsight[]
  clipPublishes     ClipPublish[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
}

// A public competitor profile the user benchmarks against (Phase 7). No OAuth
// tokens — data comes from a third-party public-data vendor
// (lib/social/competitor-source.ts), so only public stats are stored.
model CompetitorProfile {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // instagram | tiktok | youtube
  handle       String // public @handle / channel handle
  displayName  String?
  avatarUrl    String?
  followers    Int? // convenience copy of the latest snapshot
  lastSyncedAt DateTime?
  createdAt    DateTime              @default(now())
  snapshots    CompetitorSnapshot[]

  @@unique([userId, provider, handle])
  @@index([userId])
}

model CompetitorSnapshot {
  id           String            @id @default(cuid())
  competitorId String
  competitor   CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  capturedAt   DateTime          @default(now())
  followers    Int?

  @@index([competitorId, capturedAt])
}

// AI-generated performance insight for a connected social account. The numbers
// in `content` are computed deterministically (lib/social/analytics.ts) and
// injected into the prompt — the model only narrates and recommends, it never
// calculates. One row per generation; the newest row is what the UI shows.
model AiInsight {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        String        @default("weekly_summary")
  content     Json // { summary: string, wins: string[], recommendations: string[] }
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime      @default(now())

  @@index([accountId, createdAt])
}

// Audience demographics for an owned, connected account — one row per
// (dimension, bucket) per capture. Values are percentages (0–100). Refreshed
// at most weekly during sync; only providers that expose demographics for the
// authenticated account write rows (YouTube Analytics, IG follower insights).
model SocialAudienceSnapshot {
  id         String        @id @default(cuid())
  accountId  String
  account    SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedAt DateTime      @default(now())
  dimension  String // age | gender | country
  bucket     String // e.g. "18-24", "female", "US"
  value      Float // percentage of audience (0-100)

  @@index([accountId, dimension, capturedAt])
}

// Daily account-level metric snapshot — powers follower/view growth charts.
model SocialAccountSnapshot {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedAt  DateTime      @default(now())
  followers   Int?
  views       Int?
  impressions Int?
  reach       Int?
  engagement  Int?

  @@index([accountId, capturedAt])
}

// A single post/video and its latest analytics for a linked account.
model SocialPost {
  id             String        @id @default(cuid())
  accountId      String
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerPostId String
  caption        String?
  thumbnailUrl   String?
  permalink      String?
  mediaType      String? // video | image | reel | short
  publishedAt    DateTime?
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  reach          Int?
  watchTimeSec   Float?
  metricsJson    Json? // full provider payload for future-proofing
  fetchedAt      DateTime      @default(now())

  @@unique([accountId, providerPostId])
  @@index([accountId, publishedAt])
}

// Usage ledger for AI-tool generations — records what a user generated, with
// which model, for how many credits, and at what real provider cost. Phase 1
// only writes rows from image-generator, video-generator, and ai-creator; the
// other tool routes are an explicit fast-follow once they migrate onto
// lib/credits.ts's chargeCredits() (see lib/credits.ts doc comment).
model Generation {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolSlug         String // "image-generator" | "video-generator" | "ai-creator" | ...
  modelId          String? // registry model id, e.g. "flux-2"; null for non-registry tools
  generationType   String // "image" | "video" | "audio" | "utility"
  creditsCost      Int // credits actually charged (pre-refund)
  creditPool       String    @default("standard") // "standard" | "veo3"
  estimatedCostUsd Float? // researched real provider $ cost, for margin analytics
  prompt           String?
  status           String    @default("pending") // "pending" | "completed" | "failed" | "refunded" | "cancelled"
  errorMessage     String?
  progress         Int       @default(0) // 0-100, written by the job's own poll/update path
  cancelledAt      DateTime? // set when the user cancels; job checks this between processing stages
  // Client-supplied key (e.g. one UUID generated per submit click) so a
  // retried/duplicated request can't charge credits twice — chargeCredits
  // looks this up before decrementing and returns the original result if
  // a row with this key already exists.
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([userId, createdAt])
  @@index([modelId])
  @@index([toolSlug, createdAt])
  // Success-rate / failure dashboards group by (status, window).
  @@index([status, createdAt])
}

// API keys for the public API (/api/v1/**). The plaintext key is only ever
// shown once, at creation — this row stores a SHA-256 hash and a short
// prefix (for the user to tell keys apart in the UI), never the key itself.
model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String    @unique
  keyPrefix    String
  scopes       String[]  @default([])
  expiresAt    DateTime? // null = never expires
  requestCount Int       @default(0) // best-effort, incremented alongside lastUsedAt in getApiKeyAuth
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

// Reusable, account-level caption/subtitle style template — the same field
// shape as Clip.subtitleStyleOverride, saved once and applied across
// projects instead of re-styling every clip individually.
model BrandKit {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  fontName       String?
  fontSize       Int?
  baseColor      String?
  highlightColor String?
  outlineColor   String?
  shadowColor    String?
  outlineWidth   Int?
  shadowDepth    Int?
  borderStyle    Int?
  alignment      Int?
  animated       Boolean?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// Immutable log of every admin action for accountability.
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String // e.g. "user.credits_set", "plan.deactivated", "veo3.enabled"
  targetId  String?
  before    String? // JSON snapshot
  after     String? // JSON snapshot
  createdAt DateTime @default(now())

  // The viewer lists newest-first and filters by admin — both were seq scans.
  @@index([createdAt])
  @@index([adminId, createdAt])
}
