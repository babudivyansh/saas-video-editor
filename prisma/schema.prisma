generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  credits      Int        @default(0)
  role         Role       @default(USER)
  firstName    String?
  lastName     String?
  name         String?
  avatarUrl    String?
  planId       String?
  plan         Plan?      @relation(fields: [planId], references: [id])
  // Subscription state (Phase C)
  subscriptionId     String?    // Razorpay subscription/order id for the active term
  subscriptionEndsAt DateTime?  // when the prepaid term expires (null = no active sub)
  nextRefillAt       DateTime?  // when the next monthly credit grant is due
  monthlyCredits     Int        @default(0) // credits granted on each refill for the active tier
  veo3Enabled        Boolean    @default(false) // Veo3 unlocked (bundled term or paid add-on)
  createdAt    DateTime   @default(now())
  projects     Project[]
  purchases    Purchase[]
}

model Plan {
  id           String     @id @default(uuid())
  slug         String     @unique
  name         String
  priceInPaise Int
  currency     String     @default("INR")
  credits      Int
  features     String[]   @default([])
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  // Plan type (Phase C). "pack" = one-time top-up (subscriber-only),
  // "subscription" = recurring tier with monthly credit refills.
  kind           String   @default("pack")
  intervalMonths Int?     // subscription term length: 1 / 3 / 6 / 12
  monthlyCredits Int?     // credits granted each month of the term
  veo3Included   Boolean  @default(false) // Veo3 bundled free on this plan
  createdAt    DateTime   @default(now())
  users        User[]
  purchases    Purchase[]
}

model Purchase {
  id            String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String?
  plan          Plan?    @relation(fields: [planId], references: [id])
  amountInPaise Int
  credits       Int
  status        String   @default("captured")
  createdAt     DateTime @default(now())
}

model Project {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  script         String   @default("")
  voiceId        String   @default("")
  musicUrl       String?
  backgroundUrl    String   @default("")
  subtitlesStyle   Json     @default("{}")
  status           String   @default("draft")
  videoUrl         String?
  uploadedVideoUrl String?
  productType      String   @default("split-screen")
  createdAt        DateTime @default(now())
}

model RazorpayEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
}
