generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  phone                String?         @unique
  passwordHash         String
  credits              Int             @default(0)
  role                 Role            @default(USER)
  firstName            String?
  lastName             String?
  name                 String?
  avatarUrl            String?
  gender               String? // "male" | "female" | "unspecified" — validated in the API layer
  intendedUse          String? // "content_creator" | "business_marketing" | "personal" | "other" — validated in the API layer
  planId               String?
  plan                 Plan?           @relation(fields: [planId], references: [id])
  // Subscription state (Phase C)
  subscriptionId       String? // Razorpay subscription/order id for the active term
  subscriptionEndsAt   DateTime? // when the prepaid term expires (null = no active sub)
  nextRefillAt         DateTime? // when the next monthly credit grant is due
  monthlyCredits       Int             @default(0) // credits granted on each refill for the active tier
  // Affiliate program
  referredBy           String? // affiliateId that referred this user
  // Email lifecycle tracking
  lastLoginAt          DateTime? // updated on every successful login
  firstVideoAt         DateTime? // set on first successful render — triggers upsell email
  lowCreditEmailSentAt DateTime? // reset each monthly refill; prevents duplicate low-credit alerts
  expiryReminderSentAt DateTime? // tracks which expiry email (7d/3d/1d) was last sent
  reengagementSentAt   DateTime? // prevents duplicate re-engagement emails
  onboardingDay1SentAt DateTime?
  onboardingDay3SentAt DateTime?
  onboardingDay7SentAt DateTime?
  onboardingCompletedAt DateTime? // set once the welcome screen is completed or skipped — never shown again after
  primaryGoal          String? // "auto-clip" | "image" | "video" | "voiceover" | "editor" — picked on the welcome screen, validated in the API layer
  experienceLevel      String? // "beginner" | "intermediate" | "advanced" — validated in the API layer
  teamOrIndividual     String? // "individual" | "team" — validated in the API layer
  tourStep             Int? // current guided-tour step index; null once never started
  tourCompletedAt      DateTime? // set once the guided tour is completed or skipped
  dismissedHints       String[]        @default([]) // ids of FeatureHint cards the user has dismissed — never shown again
  createdAt            DateTime        @default(now())
  projects             Project[]
  assets               Asset[]
  purchases            Purchase[]
  quests               UserQuest[]
  questRewardClaimed   Boolean         @default(false)
  affiliate            Affiliate?
  referral             Referral?       @relation("ReferredByAffiliate")
  socialAccounts       SocialAccount[]
  generations          Generation[]
}

model Affiliate {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  code           String       @unique
  status         String       @default("active") // active | suspended | banned
  commissionRate Float        @default(0.20)
  totalEarned    Float        @default(0)
  totalPaid      Float        @default(0)
  createdAt      DateTime     @default(now())
  referrals      Referral[]
  commissions    Commission[]
}

model Referral {
  id             String       @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate    @relation(fields: [affiliateId], references: [id])
  referredUserId String       @unique
  referredUser   User         @relation("ReferredByAffiliate", fields: [referredUserId], references: [id])
  status         String       @default("signed_up") // signed_up | converted | flagged | fraudulent
  signupIp       String?
  signedUpAt     DateTime     @default(now())
  convertedAt    DateTime?
  commissions    Commission[]
}

model Commission {
  id              String    @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])
  referralId      String
  referral        Referral  @relation(fields: [referralId], references: [id])
  razorpayOrderId String?
  baseAmount      Float
  commissionRate  Float
  amount          Float
  status          String    @default("pending") // pending | available | paid | rejected
  createdAt       DateTime  @default(now())
  availableAt     DateTime
  paidAt          DateTime?
  payoutRef       String?
  payoutEmailSent Boolean   @default(false) // prevents duplicate "commission available" emails
}

model Plan {
  id             String     @id @default(uuid())
  slug           String     @unique
  name           String
  priceInPaise   Int
  currency       String     @default("INR")
  credits        Int
  features       String[]   @default([])
  active         Boolean    @default(true)
  sortOrder      Int        @default(0)
  // Plan type (Phase C). "pack" = one-time top-up (subscriber-only),
  // "subscription" = recurring tier with monthly credit refills.
  kind           String     @default("pack")
  intervalMonths Int? // subscription term length: 1 / 3 / 6 / 12
  monthlyCredits Int? // credits granted each month of the term
  // "creator" | "pro" | "studio" — meaningful only when kind == "subscription";
  // null for pack/addon rows. See lib/plans/tiers.ts for the TierId union and
  // gating helpers. "free" is not a Plan row — it's the sentinel tier for a
  // user with no active subscription.
  tier           String?
  createdAt      DateTime   @default(now())
  users          User[]
  purchases      Purchase[]
}

model Purchase {
  id            String   @id
  userId        String
  // Restrict, not Cascade: a Purchase row is a financial/audit record and must
  // never be silently destroyed by deleting the user it belongs to. Both
  // DELETE /api/auth/profile and the admin user-delete route explicitly check
  // for purchase history and refuse the delete with a clear message instead.
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId        String?
  plan          Plan?    @relation(fields: [planId], references: [id])
  amountInPaise Int
  credits       Int
  status        String   @default("captured")
  createdAt     DateTime @default(now())
}

// Admin-created discount codes applied at checkout. The discount lowers the
// Razorpay order amount only — credits granted are always based on the plan.
model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique // stored UPPERCASE
  description       String?
  discountType      String             @default("percent") // "percent" | "fixed"
  discountValue     Int // percent 1–100, or paise for fixed
  appliesTo         String             @default("all") // "all" | "subscription" | "pack"
  planSlugs         String[]           @default([]) // optional: restrict to specific plan slugs
  minAmountInPaise  Int                @default(0)
  maxRedemptions    Int? // null = unlimited
  perUserLimit      Int                @default(1)
  timesRedeemed     Int                @default(0)
  firstPurchaseOnly Boolean            @default(false)
  featured          Boolean            @default(false) // surfaced on the billing launch banner
  active            Boolean            @default(true)
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  redemptions       CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  orderId         String?
  discountInPaise Int
  createdAt       DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

model Project {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  script               String   @default("")
  voiceId              String   @default("")
  musicUrl             String?
  backgroundUrl        String   @default("")
  subtitlesStyle       Json     @default("{}")
  status               String   @default("draft")
  progress             Int      @default(0) // 0–100 render progress for polling
  videoUrl             String?
  uploadedVideoUrl     String?
  productType          String   @default("split-screen")
  editorDoc            Json? // browser-editor timeline document (productType "editor")
  // Auto Clip: default caption style applied to newly-picked clips (index into
  // lib/caption-styles.ts CAPTION_STYLES; -1 = captions off). See lib/render/auto-clip.
  autoClipCaptionStyle Int?
  // Auto Clip: non-fatal problems surfaced to the user as a banner instead of
  // silently degrading (e.g. ["transcription_failed"]).
  warnings             Json?
  createdAt            DateTime @default(now())
  clips                Clip[]

  @@index([userId])
  @@index([userId, status])
}

// An individual clip produced by Auto Clip. The pick job creates one row per
// AI-picked segment (status "pending_review"); the user reviews/edits picks,
// then confirming moves kept clips to "queued" and renders + uploads each
// separately so the UI can show every clip as its own card with live progress
// and an Opus-style virality score.
model Clip {
  id                String        @id @default(cuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index             Int // generation order
  title             String? // AI-generated catchy title / hook
  startSec          Float
  endSec            Float
  durationSec       Float
  aspectRatio       String        @default("9:16")
  score             Int? // calibrated virality 0–99, see lib/virality-score.ts
  scoreBreakdown    Json? // {hook, pacing, payoff, engagement, audio, speechRate} sub-scores for transparency
  mood              String? // AI-detected content mood, drives auto color grade (P2.3)
  status            String        @default("queued") // pending_review | queued | rendering | ready | failed
  progress          Int           @default(0) // 0–100
  videoUrl          String?
  thumbnailUrl      String?
  // Captioning (P0.3) — transcript is sliced/re-baselined to this clip's own
  // timeline so re-render (P1.3) never needs to re-run STT.
  transcriptJson    Json?
  captionStyleIndex Int?
  hasCaptions       Boolean       @default(false)
  // Speaker-tracking reframe (P1.1) — smoothed crop path in source-pixel
  // coordinates, [{tSec, x, y, w, h}]. Null = static center crop (fallback).
  cropKeyframes     Json?
  // Auto B-roll (P2.3) — a Pexels stock clip spliced in for [brollStartSec,
  // brollEndSec) (clip-relative) while the original audio continues. Null
  // brollUrl = no B-roll for this clip (Gemini found no natural opportunity,
  // clip too short, or Pexels unavailable/unconfigured).
  brollQuery        String?
  brollUrl          String?
  brollStartSec     Float?
  brollEndSec       Float?
  createdAt         DateTime      @default(now())
  dubs              ClipDub[]
  publishes         ClipPublish[]

  @@index([projectId])
  @@index([projectId, status])
}

// A dubbed-audio variant of a Clip in another language (P2.2). Captions stay
// in the source language for v1 — re-aligning captions to dubbed audio would
// require re-running STT on the dub, deferred as a known limitation shared by
// several competitors.
model ClipDub {
  id         String   @id @default(cuid())
  clipId     String
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  targetLang String
  status     String   @default("dubbing") // dubbing | ready | failed
  videoUrl   String?
  createdAt  DateTime @default(now())

  @@index([clipId])
}

// A publish record linking a Clip to a connected SocialAccount. Actually
// pushing new video content to YouTube/Instagram/Facebook needs write-scope
// OAuth grants this app doesn't request today (SocialAccount is read-only
// analytics per its own doc comment) plus platform app review — out of scope
// to silently wire up. This model instead tracks "I posted this externally"
// (user pastes the permalink after manually publishing) so the existing
// social-refresh sync can pull real performance data back onto the clip,
// closing the analytics loop without requiring new OAuth scopes.
model ClipPublish {
  id              String        @id @default(cuid())
  clipId          String
  clip            Clip          @relation(fields: [clipId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  providerPostId  String? // set once the user links the live post/permalink
  permalink       String?
  status          String        @default("pending") // pending | linked | failed
  metricsJson     Json? // cached NormalizedPost-shaped snapshot, refreshed by lib/social/refresh-queue.ts
  scheduledFor    DateTime?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([clipId])
  @@index([socialAccountId])
}

model RazorpayEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
}

// Key-value store for runtime admin configuration (e.g. tool enable/disable, credit costs).
model Config {
  key   String @id
  value String // JSON string
}

model UserQuest {
  id          String   @id @default(uuid())
  userId      String
  questId     String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model Asset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  s3Key     String
  url       String
  mimeType  String
  kind      String // "video" | "audio" | "image"
  size      Int
  duration  Float?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A social platform account a user has linked via OAuth (Social Tracker).
// OAuth tokens are stored ONLY as AES-256-GCM ciphertext (lib/encryption.ts) and
// are never returned to the client. Read-only analytics scopes only.
model SocialAccount {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "youtube" | "instagram" | "facebook"
  providerAccountId String // channel id / IG user id / Page id
  username          String?
  displayName       String?
  avatarUrl         String?
  accessTokenEnc    String // AES-256-GCM ciphertext
  refreshTokenEnc   String? // AES-256-GCM ciphertext
  tokenExpiresAt    DateTime?
  scopes            String[]                @default([])
  status            String                  @default("active") // active | needs_reauth | revoked
  followers         Int? // convenience copy of the latest snapshot
  lastSyncedAt      DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  posts             SocialPost[]
  snapshots         SocialAccountSnapshot[]
  clipPublishes     ClipPublish[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
}

// Daily account-level metric snapshot — powers follower/view growth charts.
model SocialAccountSnapshot {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedAt  DateTime      @default(now())
  followers   Int?
  views       Int?
  impressions Int?
  reach       Int?
  engagement  Int?

  @@index([accountId, capturedAt])
}

// A single post/video and its latest analytics for a linked account.
model SocialPost {
  id             String        @id @default(cuid())
  accountId      String
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerPostId String
  caption        String?
  thumbnailUrl   String?
  permalink      String?
  mediaType      String? // video | image | reel | short
  publishedAt    DateTime?
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  reach          Int?
  watchTimeSec   Float?
  metricsJson    Json? // full provider payload for future-proofing
  fetchedAt      DateTime      @default(now())

  @@unique([accountId, providerPostId])
  @@index([accountId, publishedAt])
}

// Usage ledger for AI-tool generations — records what a user generated, with
// which model, for how many credits, and at what real provider cost. Phase 1
// only writes rows from image-generator, video-generator, and ai-creator; the
// other tool routes are an explicit fast-follow once they migrate onto
// lib/credits.ts's chargeCredits() (see lib/credits.ts doc comment).
model Generation {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolSlug         String // "image-generator" | "video-generator" | "ai-creator" | ...
  modelId          String? // registry model id, e.g. "flux-2"; null for non-registry tools
  generationType   String // "image" | "video" | "audio" | "utility"
  creditsCost      Int // credits actually charged (pre-refund)
  creditPool       String    @default("standard") // "standard" | "veo3"
  estimatedCostUsd Float? // researched real provider $ cost, for margin analytics
  prompt           String?
  status           String    @default("pending") // "pending" | "completed" | "failed" | "refunded" | "cancelled"
  errorMessage     String?
  progress         Int       @default(0) // 0-100, written by the job's own poll/update path
  cancelledAt      DateTime? // set when the user cancels; job checks this between processing stages
  // Client-supplied key (e.g. one UUID generated per submit click) so a
  // retried/duplicated request can't charge credits twice — chargeCredits
  // looks this up before decrementing and returns the original result if
  // a row with this key already exists.
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([userId, createdAt])
  @@index([modelId])
  @@index([toolSlug, createdAt])
}

// Immutable log of every admin action for accountability.
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String // e.g. "user.credits_set", "plan.deactivated", "veo3.enabled"
  targetId  String?
  before    String? // JSON snapshot
  after     String? // JSON snapshot
  createdAt DateTime @default(now())
}
