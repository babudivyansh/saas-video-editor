generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  credits      Int        @default(0)
  role         Role       @default(USER)
  firstName    String?
  lastName     String?
  name         String?
  avatarUrl    String?
  planId       String?
  plan         Plan?      @relation(fields: [planId], references: [id])
  // Subscription state (Phase C)
  subscriptionId     String?    // Razorpay subscription/order id for the active term
  subscriptionEndsAt DateTime?  // when the prepaid term expires (null = no active sub)
  nextRefillAt       DateTime?  // when the next monthly credit grant is due
  monthlyCredits     Int        @default(0) // credits granted on each refill for the active tier
  veo3Enabled        Boolean    @default(false) // Veo3 unlocked (bundled term or paid add-on)
  // Affiliate program
  referredBy         String?    // affiliateId that referred this user
  createdAt    DateTime   @default(now())
  projects             Project[]
  assets               Asset[]
  purchases            Purchase[]
  quests               UserQuest[]
  questRewardClaimed   Boolean    @default(false)
  affiliate            Affiliate?
  referral             Referral?  @relation("ReferredByAffiliate")
}

model Affiliate {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  code           String       @unique
  status         String       @default("active")  // active | suspended | banned
  commissionRate Float        @default(0.20)
  totalEarned    Float        @default(0)
  totalPaid      Float        @default(0)
  createdAt      DateTime     @default(now())
  referrals      Referral[]
  commissions    Commission[]
}

model Referral {
  id             String      @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate   @relation(fields: [affiliateId], references: [id])
  referredUserId String      @unique
  referredUser   User        @relation("ReferredByAffiliate", fields: [referredUserId], references: [id])
  status         String      @default("signed_up")  // signed_up | converted | flagged | fraudulent
  signupIp       String?
  signedUpAt     DateTime    @default(now())
  convertedAt    DateTime?
  commissions    Commission[]
}

model Commission {
  id              String    @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])
  referralId      String
  referral        Referral  @relation(fields: [referralId], references: [id])
  razorpayOrderId String?
  baseAmount      Float
  commissionRate  Float
  amount          Float
  status          String    @default("pending")  // pending | available | paid | rejected
  createdAt       DateTime  @default(now())
  availableAt     DateTime
  paidAt          DateTime?
  payoutRef       String?
}

model Plan {
  id           String     @id @default(uuid())
  slug         String     @unique
  name         String
  priceInPaise Int
  currency     String     @default("INR")
  credits      Int
  features     String[]   @default([])
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  // Plan type (Phase C). "pack" = one-time top-up (subscriber-only),
  // "subscription" = recurring tier with monthly credit refills.
  kind           String   @default("pack")
  intervalMonths Int?     // subscription term length: 1 / 3 / 6 / 12
  monthlyCredits Int?     // credits granted each month of the term
  veo3Included   Boolean  @default(false) // Veo3 bundled free on this plan
  createdAt    DateTime   @default(now())
  users        User[]
  purchases    Purchase[]
}

model Purchase {
  id            String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String?
  plan          Plan?    @relation(fields: [planId], references: [id])
  amountInPaise Int
  credits       Int
  status        String   @default("captured")
  createdAt     DateTime @default(now())
}

model Project {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  script         String   @default("")
  voiceId        String   @default("")
  musicUrl       String?
  backgroundUrl    String   @default("")
  subtitlesStyle   Json     @default("{}")
  status           String   @default("draft")
  videoUrl         String?
  uploadedVideoUrl String?
  productType      String   @default("split-screen")
  editorDoc        Json?    // serialized advanced-editor timeline (tracks, overlays, captions, crop)
  createdAt        DateTime @default(now())
}

model RazorpayEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
}

// Key-value store for runtime admin configuration (e.g. tool enable/disable, credit costs).
model Config {
  key   String @id
  value String // JSON string
}

model UserQuest {
  id          String   @id @default(uuid())
  userId      String
  questId     String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model Asset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  s3Key     String
  url       String
  mimeType  String
  kind      String   // "video" | "audio" | "image"
  size      Int
  duration  Float?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable log of every admin action for accountability.
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String   // e.g. "user.credits_set", "plan.deactivated", "veo3.enabled"
  targetId  String?
  before    String?  // JSON snapshot
  after     String?  // JSON snapshot
  createdAt DateTime @default(now())
}
