generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  phone                    String?   @unique
  passwordHash             String
  // Denormalized TOTAL balance = bonus + subscription + purchased, maintained
  // atomically by lib/credits.ts in the same statement as every bucket
  // mutation (2026-07 bucket split). Read-only everywhere else — all existing
  // balance reads (auth payloads, admin dashboards) keep working off this.
  credits                  Int       @default(0)
  // Credit buckets. Spend order: bonus -> subscription -> purchased (see
  // lib/credits.ts spendCredits). Subscription credits roll over up to 2x the
  // monthly grant and are zeroed on lapse; purchased (pack) credits never
  // expire; bonus credits expire at bonusCreditsExpireAt.
  subscriptionCredits      Int       @default(0)
  purchasedCredits         Int       @default(0)
  bonusCredits             Int       @default(0)
  bonusCreditsExpireAt     DateTime?
  // Free-tier monthly grant anchor: users without an active plan get a small
  // bonus-credit refill each month (cron step 4). Null for subscribers.
  freeCreditsRefillAt      DateTime?
  // ── Razorpay Subscriptions (true recurring billing, 2026-07) ──
  // Null = legacy prepaid subscriber (one-time orders; cron-refilled).
  // Set = renewals arrive via the subscription.charged webhook.
  razorpaySubscriptionId   String?   @unique
  razorpayCustomerId       String?
  // 7-day Pro trial: once per account, card-authorized upfront.
  trialUsedAt              DateTime?
  trialEndsAt              DateTime?
  // Set when the user requests cancel-at-cycle-end (POST /api/billing/cancel).
  // Access continues until subscriptionEndsAt regardless — this only marks
  // intent so the billing UI shows "Cancelled — access until {date}" instead
  // of offering Cancel again. Cleared whenever a subscription (re)activates
  // (subscription.activated webhook) or lapses (refill-credits cron).
  subscriptionCancelledAt  DateTime?
  // ── Dunning (2026-07 billing audit) ──
  // Set when Razorpay reports a recurring charge failed (payment.failed) or the
  // subscription entered its retry state (subscription.pending). Cleared on the
  // next successful charge. Before this existed a declined card produced no DB
  // write, no email and no in-app signal — the customer kept full access for
  // the ~33 days of accumulated grace while the UI still read "Renews in N
  // days", and nobody on either side knew anything was wrong.
  paymentFailedAt          DateTime?
  // Consecutive failed charge attempts, reset on success. Drives how insistent
  // the in-app banner is, and stops the same failure emailing repeatedly when
  // Razorpay retries.
  paymentFailureCount      Int       @default(0)
  paymentFailedEmailSentAt DateTime?
  // Opt-in auto top-up (2026-07 audit): when set, a spend that leaves the
  // balance under the threshold triggers lib/credits.ts's maybeAutoTopup —
  // a debounced attempt to purchase this pack (one-click email in practice;
  // see lib/email.ts sendAutoTopupPromptEmail and the RBI-mandate note there).
  autoTopupPackSlug        String?
  role                     Role      @default(USER)
  firstName                String?
  lastName                 String?
  name                     String?
  avatarUrl                String?
  gender                   String? // "male" | "female" | "unspecified" — validated in the API layer
  intendedUse              String? // "content_creator" | "business_marketing" | "personal" | "other" — validated in the API layer
  preferredLanguage        String    @default("en") // ISO 639-1 code — validated against lib/i18n-locales.ts's supported-locale list in the API layer
  planId                   String?
  plan                     Plan?     @relation(fields: [planId], references: [id])
  // Subscription state (Phase C)
  subscriptionId           String? // Razorpay subscription/order id for the active term
  subscriptionEndsAt       DateTime? // when the prepaid term expires (null = no active sub)
  nextRefillAt             DateTime? // when the next monthly credit grant is due
  monthlyCredits           Int       @default(0) // credits granted on each refill for the active tier
  // Affiliate program
  referredBy               String? // affiliateId that referred this user
  // Email lifecycle tracking
  lastLoginAt              DateTime? // updated on every successful login
  firstVideoAt             DateTime? // set on first successful render — triggers upsell email
  lowCreditEmailSentAt     DateTime? // reset each monthly refill; prevents duplicate low-credit alerts
  expiryReminderSentAt     DateTime? // tracks which expiry email (7d/3d/1d) was last sent
  reengagementSentAt       DateTime? // prevents duplicate re-engagement emails
  onboardingDay1SentAt     DateTime?
  onboardingDay3SentAt     DateTime?
  onboardingDay7SentAt     DateTime?
  onboardingCompletedAt    DateTime? // set once the welcome screen is completed or skipped — never shown again after
  primaryGoal              String? // "auto-clip" | "image" | "video" | "voiceover" | "editor" — picked on the welcome screen, validated in the API layer
  experienceLevel          String? // "beginner" | "intermediate" | "advanced" — validated in the API layer
  teamOrIndividual         String? // "individual" | "team" — validated in the API layer
  tourStep                 Int? // current guided-tour step index; null once never started
  tourCompletedAt          DateTime? // set once the guided tour is completed or skipped
  dismissedHints           String[]  @default([]) // ids of FeatureHint cards the user has dismissed — never shown again
  // Admin moderation (Phase 3): a suspended user fails auth on every request
  // (lib/auth.ts getAuthUser) until un-suspended. Soft alternative to deletion.
  suspendedAt              DateTime?
  adminNotes               String? // free-form internal notes, admin console only — never exposed to the user

  // Email verification / change. email itself flips only once the pending
  // address is confirmed (see app/api/auth/change-email/confirm) — never
  // swapped eagerly.
  emailVerifiedAt DateTime?
  pendingEmail    String?

  // Password/session security
  passwordChangedAt DateTime? // set on every successful change-password; used by the account-dashboard security score

  // Two-factor authentication (TOTP, RFC 6238). Secret is AES-256-GCM
  // ciphertext (lib/encryption.ts) — never stored or returned as plaintext.
  twoFactorEnabled      Boolean                 @default(false)
  twoFactorSecretEnc    String?
  // Highest 30s time-step already spent on a successful verification. A TOTP
  // code stays valid for its whole ±1-step window (~90s), so without this a
  // code captured over the shoulder or through a phishing proxy can be
  // replayed; rejecting any step <= this one makes every code single-use.
  // Int is safe: the step is unix-seconds/30, ~58M today against a 2.1B
  // ceiling.
  twoFactorLastUsedStep Int?
  recoveryCodes         TwoFactorRecoveryCode[]

  // Soft account deactivation — a recovery window before the existing hard-delete
  // flow (DELETE /api/auth/profile) runs. Login is blocked while deactivatedAt is set.
  deactivatedAt                DateTime?
  deactivationScheduledPurgeAt DateTime?

  notificationPreference NotificationPreference?

  createdAt           DateTime             @default(now())
  projects            Project[]
  assets              Asset[]
  purchases           Purchase[]
  creditTransactions  CreditTransaction[]
  quests              UserQuest[]
  questRewardClaimed  Boolean              @default(false)
  claimedRankRewards  String[]             @default([])
  affiliate           Affiliate?
  referral            Referral?            @relation("ReferredByAffiliate")
  socialAccounts      SocialAccount[]
  competitors         CompetitorProfile[]
  socialGoals         SocialGoal[]
  socialReportConfigs SocialReportConfig[]
  socialReportRuns    SocialReportRun[]
  socialReportLinks   SocialReportLink[]
  generations         Generation[]
  loginEvents         LoginEvent[]
  apiKeys             ApiKey[]
  brandKits           BrandKit[]
  clonedVoices        ClonedVoice[]
  assetFolders        AssetFolder[]
  tags                Tag[]
  assetAuditLogs      AssetAuditLog[]
  pendingUploads      PendingUpload[]
  review              Review?
  reviewAttachments   ReviewAttachment[]
  reviewHelpfulVotes  ReviewHelpfulVote[]
  reviewReports       ReviewReport[]
  notifications       Notification[]
  subscriptionEvents  SubscriptionEvent[]
  reviewPromptState   ReviewPromptState?
  reviewPromptEvents  ReviewPromptEvent[]
  reviewEmailSequence ReviewEmailSequence?
}

// One-time hashed 2FA recovery code — issued 10-at-a-time on enrollment,
// each usable exactly once as a TOTP fallback (lost authenticator device).
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Per-user opt-out flags for non-critical email categories. Absence of a row
// means "all defaults (on)" — created lazily on first read/write, not at
// signup, so most users never get a row until they actually touch this page.
// Security-critical mail (new-login alert, password-changed, email-changed,
// purchase confirmation) is NEVER gated by this table — see lib/notifications.ts.
model NotificationPreference {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingEmails Boolean  @default(true)
  productUpdates  Boolean  @default(true)
  usageAlerts     Boolean  @default(true)
  creditAlerts    Boolean  @default(true)
  weeklySummary   Boolean  @default(true)
  featureReleases Boolean  @default(true)
  newsletter      Boolean  @default(true)
  reviewPrompts   Boolean  @default(true) // gates lib/email.ts's sendReviewPromptEmail (P7) — finer-grained than productUpdates since it's a nudge, not general product news
  updatedAt       DateTime @updatedAt
}

// One row per successful login (Phase 3) — powers the admin user-detail login
// history and, over time, device/country analytics. The login route already
// computed device + geo transiently for the sign-in alert email; now it also
// persists them.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  device    String?
  country   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Affiliate {
  id                        String       @id @default(cuid())
  userId                    String       @unique
  user                      User         @relation(fields: [userId], references: [id])
  code                      String       @unique
  status                    String       @default("active") // active | suspended | banned
  commissionRate            Float        @default(0.20)
  totalEarned               Float        @default(0)
  totalPaid                 Float        @default(0)
  // Null = never expires (true of every code issued so far). Lets "expired"
  // be a real, testable rejection reason for the sign-up referral-code field
  // (see lib/affiliate.ts resolveReferralCode) instead of unreachable.
  codeExpiresAt             DateTime?
  // Set when the affiliate clicks "Request Payout" (payout-request route);
  // cleared when an admin marks them paid. Purely a UI/visibility signal —
  // never gates anything server-side.
  payoutRequestedAt         DateTime?
  // Dedupe guard for the admin "available balance crossed the payout
  // threshold" email (see lib/affiliate.ts notifyAdminsIfPayoutEligible).
  // Set only after at least one admin email actually sends; cleared
  // alongside payoutRequestedAt when an admin marks them paid, so the next
  // earning cycle can notify again.
  payoutThresholdNotifiedAt DateTime?
  createdAt                 DateTime     @default(now())
  referrals                 Referral[]
  commissions               Commission[]
}

model Referral {
  id             String       @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate    @relation(fields: [affiliateId], references: [id])
  referredUserId String       @unique
  referredUser   User         @relation("ReferredByAffiliate", fields: [referredUserId], references: [id])
  status         String       @default("signed_up") // signed_up | converted | flagged | fraudulent
  signupIp       String?
  signedUpAt     DateTime     @default(now())
  convertedAt    DateTime?
  commissions    Commission[]

  @@index([affiliateId])
}

model Commission {
  id              String    @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id])
  referralId      String
  referral        Referral  @relation(fields: [referralId], references: [id])
  razorpayOrderId String?
  baseAmount      Float
  commissionRate  Float
  amount          Float
  status          String    @default("pending") // pending | available | paid | rejected
  createdAt       DateTime  @default(now())
  availableAt     DateTime
  paidAt          DateTime?
  payoutRef       String?
  payoutEmailSent Boolean   @default(false) // prevents duplicate "commission available" emails

  @@index([affiliateId])
  @@index([referralId])
}

model Plan {
  id                String     @id @default(uuid())
  slug              String     @unique
  name              String
  priceInPaise      Int
  currency          String     @default("INR")
  credits           Int
  features          String[]   @default([])
  active            Boolean    @default(true)
  sortOrder         Int        @default(0)
  // Plan type (Phase C). "pack" = one-time top-up (subscriber-only),
  // "subscription" = recurring tier with monthly credit refills.
  kind              String     @default("pack")
  // Razorpay Plan ids for the recurring Subscriptions flow, per currency.
  // Provisioned by scripts/razorpay-sync-plans.ts; null until synced (the
  // legacy one-time order flow keeps working for unsynced plans).
  razorpayPlanIdInr String?
  razorpayPlanIdUsd String?
  intervalMonths    Int? // subscription term length: 1 / 3 / 6 / 12
  monthlyCredits    Int? // credits granted each month of the term
  // "creator" | "pro" | "studio" — meaningful only when kind == "subscription";
  // null for pack/addon rows. See lib/plans/tiers.ts for the TierId union and
  // gating helpers. "free" is not a Plan row — it's the sentinel tier for a
  // user with no active subscription.
  tier              String?
  createdAt         DateTime   @default(now())
  users             User[]
  purchases         Purchase[]
}

model Purchase {
  id            String   @id
  userId        String
  // Restrict, not Cascade: a Purchase row is a financial/audit record and must
  // never be silently destroyed by deleting the user it belongs to. Both
  // DELETE /api/auth/profile and the admin user-delete route explicitly check
  // for purchase history and refuse the delete with a clear message instead.
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId        String?
  plan          Plan?    @relation(fields: [planId], references: [id])
  amountInPaise Int
  credits       Int
  status        String   @default("captured")
  createdAt     DateTime @default(now())

  // Admin dashboards aggregate purchases by day and by (status, window)
  // constantly — these keep the metrics endpoint fast as rows grow.
  @@index([createdAt])
  @@index([status, createdAt])
}

// Admin-created discount codes applied at checkout. The discount lowers the
// Razorpay order amount only — credits granted are always based on the plan.
model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique // stored UPPERCASE
  description       String?
  discountType      String             @default("percent") // "percent" | "fixed"
  discountValue     Int // percent 1–100, or paise for fixed
  appliesTo         String             @default("all") // "all" | "subscription" | "pack"
  planSlugs         String[]           @default([]) // optional: restrict to specific plan slugs
  minAmountInPaise  Int                @default(0)
  maxRedemptions    Int? // null = unlimited
  perUserLimit      Int                @default(1)
  timesRedeemed     Int                @default(0)
  firstPurchaseOnly Boolean            @default(false)
  featured          Boolean            @default(false) // surfaced on the billing launch banner
  active            Boolean            @default(true)
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  redemptions       CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  orderId         String?
  discountInPaise Int
  createdAt       DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

model Project {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  script               String   @default("")
  voiceId              String   @default("")
  musicUrl             String?
  backgroundUrl        String   @default("")
  subtitlesStyle       Json     @default("{}")
  status               String   @default("draft")
  progress             Int      @default(0) // 0–100 render progress for polling
  videoUrl             String?
  uploadedVideoUrl     String?
  productType          String   @default("split-screen")
  editorDoc            Json? // browser-editor timeline document (productType "editor")
  // Auto Clip: default caption style applied to newly-picked clips (index into
  // lib/caption-styles.ts CAPTION_STYLES; -1 = captions off). See lib/render/auto-clip.
  autoClipCaptionStyle Int?
  // Auto Clip: non-fatal problems surfaced to the user as a banner instead of
  // silently degrading (e.g. ["transcription_failed"]).
  warnings             Json?
  // Auto Clip: user-facing reason the run failed ("Video is too short…",
  // "…your plan supports Auto Clips up to 30 min"). The pipeline already
  // throws these as sentences written for a creator, but they used to die in
  // the queue and the UI could only say "something went wrong".
  failureReason        String?
  faceTimeline         Json?
  createdAt            DateTime @default(now())
  clips                Clip[]

  @@index([userId])
  @@index([userId, status])
}

// An individual clip produced by Auto Clip. The pick job creates one row per
// AI-picked segment (status "pending_review"); the user reviews/edits picks,
// then confirming moves kept clips to "queued" and renders + uploads each
// separately so the UI can show every clip as its own card with live progress
// and an Opus-style virality score.
model Clip {
  id                    String        @id @default(cuid())
  projectId             String
  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index                 Int // generation order
  title                 String? // AI-generated catchy title / hook
  startSec              Float
  endSec                Float
  durationSec           Float
  aspectRatio           String        @default("9:16")
  score                 Int? // calibrated virality 0–99, see lib/virality-score.ts
  rerenderCount         Int           @default(0) // first re-render per clip is free; charged after that
  scoreBreakdown        Json? // {hook, pacing, payoff, engagement, audio, speechRate} sub-scores for transparency
  mood                  String? // AI-detected content mood, drives auto color grade (P2.3)
  status                String        @default("queued") // pending_review | queued | rendering | ready | failed
  progress              Int           @default(0) // 0–100
  videoUrl              String?
  thumbnailUrl          String?
  // Captioning (P0.3) — transcript is sliced/re-baselined to this clip's own
  // timeline so re-render (P1.3) never needs to re-run STT.
  transcriptJson        Json?
  captionStyleIndex     Int?
  hasCaptions           Boolean       @default(false)
  // Speaker-tracking reframe (P1.1) — smoothed crop path in source-pixel
  // coordinates, [{tSec, x, y, w, h}]. Null = static center crop (fallback).
  cropKeyframes         Json?
  // Auto B-roll (P2.3) — a Pexels stock clip spliced in for [brollStartSec,
  // brollEndSec) (clip-relative) while the original audio continues. Null
  // brollUrl = no B-roll for this clip (Gemini found no natural opportunity,
  // clip too short, or Pexels unavailable/unconfigured).
  brollQuery            String?
  brollUrl              String?
  brollStartSec         Float?
  brollEndSec           Float?
  // Keyword-driven B-roll: up to a few inserts per clip, each landing on the
  // word the speaker actually says. [{startSec, endSec, url, query}]. The
  // single brollUrl fields above remain for clips picked before this existed.
  brollWindows          Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt // stale-clip sweep reads this — see lib/cron/stale-clip-sweep.ts
  subtitleStyleOverride Json?
  silenceSettings       Json?
  // Per-clip speech signal track (loudness/pitch/energy envelopes, shot
  // boundaries, pauses) — drives energy-reactive zoom and caption animation.
  // See lib/signal-track.ts.
  signalTrack           Json?
  // Inline "lite editor" adjustments: speed, music bed, B-roll swap,
  // transitions. Versioned + zod-validated on write (lib/autoclip-lite.ts).
  // Trim deliberately stays in startSec/endSec rather than moving in here —
  // rebaseClipWords and the cropKeyframes invalidation both key off those
  // columns, and two sources of truth for the in/out points would be the
  // worst possible field to duplicate.
  liteEdits             Json?
  // Downsampled waveform peaks for the editor scrubber, computed once during
  // render so the browser never decodes a multi-hour source.
  audioPeaks            Json?
  // Which backend actually encoded this clip ("cpu" | "gpu"), for ops.
  renderTarget          String?
  dubs                  ClipDub[]
  publishes             ClipPublish[]

  @@index([projectId])
  @@index([projectId, status])
}

// A dubbed-audio variant of a Clip in another language (P2.2). Captions stay
// in the source language for v1 — re-aligning captions to dubbed audio would
// require re-running STT on the dub, deferred as a known limitation shared by
// several competitors.
model ClipDub {
  id         String   @id @default(cuid())
  clipId     String
  clip       Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  targetLang String
  status     String   @default("dubbing") // dubbing | ready | failed
  videoUrl   String?
  createdAt  DateTime @default(now())

  @@index([clipId])
}

// A publish record linking a Clip to a connected SocialAccount. Actually
// pushing new video content to YouTube/Instagram/Facebook needs write-scope
// OAuth grants this app doesn't request today (SocialAccount is read-only
// analytics per its own doc comment) plus platform app review — out of scope
// to silently wire up. This model instead tracks "I posted this externally"
// (user pastes the permalink after manually publishing) so the existing
// social-refresh sync can pull real performance data back onto the clip,
// closing the analytics loop without requiring new OAuth scopes.
model ClipPublish {
  id              String        @id @default(cuid())
  clipId          String
  clip            Clip          @relation(fields: [clipId], references: [id], onDelete: Cascade)
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  providerPostId  String? // set once the user links the live post/permalink
  permalink       String?
  status          String        @default("pending") // pending | linked | failed
  metricsJson     Json? // cached NormalizedPost-shaped snapshot, refreshed by lib/social/refresh-queue.ts
  scheduledFor    DateTime?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([clipId])
  @@index([socialAccountId])
}

model RazorpayEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
}

// Append-only log of subscription lifecycle events from Razorpay. Separate
// from RazorpayEvent, which is keyed on payment id purely as an idempotency
// claim and records nothing useful: it cannot answer "why did this customer
// lose access?", which is the question support actually gets. Halts, pending
// retries, pauses and cancellations were previously log-only — they vanished
// into stdout with no queryable record at all.
model SubscriptionEvent {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String // Razorpay sub_...
  type           String // "payment_failed" | "pending" | "halted" | "cancelled" | "paused" | "resumed" | "charged" | "activated"
  /// Failure reason / error code from the provider, when it gave one.
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([subscriptionId])
}

// Append-only ledger of every credit balance change, per bucket. Written
// exclusively by lib/credits.ts (grantCredits/spendCredits/refundSpend and
// the cron's cap/lapse/expiry steps). refId ties spend rows to a Generation
// id (or grant rows to a Razorpay payment id) so refunds can reverse exactly
// the buckets a spend drained.
model CreditTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket    String // "bonus" | "subscription" | "purchased"
  delta     Int // positive = grant, negative = spend/expire
  reason    String // "spend:<toolSlug>" | "grant:pack" | "grant:refill" | "refund" | "expire" | "lapse" | ...
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([refId])
}

// Key-value store for runtime admin configuration (e.g. tool enable/disable, credit costs).
model Config {
  key   String @id
  value String // JSON string
}

model UserQuest {
  id          String   @id @default(uuid())
  userId      String
  questId     String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model Asset {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  s3Key    String
  url      String // legacy permanent URL, kept for rows created before signed URLs; reads now resolve a fresh presigned URL from s3Key instead of trusting this column
  mimeType String
  kind     String // "video" | "audio" | "image"
  size     Int
  duration Float?
  width    Int?
  height   Int?

  // Organization (folders/tags/favorites/archive)
  folderId   String?
  folder     AssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  isFavorite Boolean      @default(false)
  archivedAt DateTime? // soft-delete: set on Archive, cleared on Restore, hard-deleted by the cleanup cron after the retention window
  tags       AssetTag[]

  // Thumbnails — a lightweight extracted frame/preview so the grid never has
  // to stream the full source file just to render a card.
  thumbnailS3Key String?

  // Duplicate detection — SHA-256 of the uploaded bytes, computed server-side.
  checksum String?

  // Moderation (Rekognition DetectModerationLabels, async via the
  // asset-moderation queue). "not_configured" is reserved for the malware-scan
  // step, which has no vendor wired up yet — it is never silently marked "clean".
  moderationStatus String @default("pending") // "pending" | "clean" | "flagged" | "skipped" | "not_configured"
  moderationLabels Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AssetAuditLog[]

  @@unique([userId, checksum])
  @@index([userId, createdAt])
  @@index([userId, kind])
  @@index([userId, archivedAt])
  @@index([folderId])
}

// Flat (non-nested) per-user folder for organizing assets.
model AssetFolder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@unique([userId, name])
  @@index([userId])
}

// Reusable per-user tag — a real row (not a denormalized string array) so the
// UI can list/autocomplete/rename a user's whole tag vocabulary.
model Tag {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  assets    AssetTag[]

  @@unique([userId, name])
  @@index([userId])
}

model AssetTag {
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId])
}

// Per-user history of asset actions (upload/rename/delete/archive/restore/
// bulk-*/moderation-flag) — the user-facing counterpart to lib/admin/audit.ts.
model AssetAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([assetId])
}

// Written right before the S3 PUT and deleted right after a successful
// Asset.create — lets the cleanup cron find orphaned S3 objects (upload
// succeeded, DB insert didn't) without an expensive bucket ListObjects scan.
model PendingUpload {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  s3Key             String
  // Set only for a client-driven S3 multipart upload (large files) — lets the
  // cleanup cron abort the incomplete multipart upload (AbortMultipartUpload)
  // instead of trying DeleteObject on a key that was never a real object.
  multipartUploadId String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// A social platform account a user has linked via OAuth (Social Tracker).
// OAuth tokens are stored ONLY as AES-256-GCM ciphertext (lib/encryption.ts) and
// are never returned to the client. Read-only analytics scopes only.
model SocialAccount {
  id                  String                   @id @default(cuid())
  userId              String
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider            String // "youtube" | "instagram" | "facebook"
  providerAccountId   String // channel id / IG user id / Page id
  username            String?
  displayName         String?
  avatarUrl           String?
  accessTokenEnc      String // AES-256-GCM ciphertext
  refreshTokenEnc     String? // AES-256-GCM ciphertext
  tokenExpiresAt      DateTime?
  scopes              String[]                 @default([])
  status              String                   @default("active") // active | needs_reauth | revoked
  followers           Int? // convenience copy of the latest snapshot
  lastSyncedAt        DateTime?
  lastSyncStatus      String                   @default("ok") // ok | partial | failed
  lastSyncError       String? // human-readable reason when partial/failed
  // IANA zone (e.g. "Asia/Kolkata"), from the provider or the user's setting.
  // Storing it removes the per-request `tz` query param that fragmented the
  // analytics cache across every client offset.
  timezone            String?
  // Per-account capability overlay written by the sync: which metrics THIS
  // account actually returned. Narrows the static matrix in
  // lib/social/capabilities.ts so the UI can say "your Page hasn't granted
  // read_insights" rather than showing a permanently empty tile.
  // Shape: Partial<Record<MetricKey, "native" | "derived" | "unavailable">>
  capabilitiesJson    Json?
  healthScore         Float? // 0-100, recomputed nightly (lib/social/metrics/scores)
  healthScoreAt       DateTime?
  // Incremental cursor for SocialDailyMetric. Steady-state syncs re-fetch from
  // (cursor - 2 days) because providers restate the last 24-48h.
  lastDailyMetricDate DateTime?                @db.Date
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  posts               SocialPost[]
  snapshots           SocialAccountSnapshot[]
  dailyMetrics        SocialDailyMetric[]
  audience            SocialAudienceSnapshot[]
  insights            AiInsight[]
  goals               SocialGoal[]
  clipPublishes       ClipPublish[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId])
}

// A public competitor profile the user benchmarks against (Phase 7). No OAuth
// tokens — data comes from a third-party public-data vendor
// (lib/social/competitor-source.ts), so only public stats are stored.
model CompetitorProfile {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // instagram | youtube
  handle       String // public @handle / channel handle
  displayName  String?
  avatarUrl    String?
  category     String? // vendor-reported niche, when available
  bio          String?
  followers    Int? // convenience copy of the latest snapshot
  lastSyncedAt DateTime?
  createdAt    DateTime             @default(now())
  snapshots    CompetitorSnapshot[]

  @@unique([userId, provider, handle])
  @@index([userId])
}

// Only `followers` was captured before, which is why competitor tracking could
// not answer anything beyond "are they bigger than me". The added columns are
// what the comparison view needs; all remain nullable because vendor coverage
// varies by platform and by profile.
model CompetitorSnapshot {
  id             String            @id @default(cuid())
  competitorId   String
  competitor     CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  capturedAt     DateTime          @default(now())
  followers      Int?
  following      Int?
  postsCount     Int?
  avgLikes       Float?
  avgComments    Float?
  engagementRate Float? // percent, computed by the vendor adapter
  postsPerWeek   Float?

  @@index([competitorId, capturedAt])
}

// AI-generated performance insight for a connected social account. The numbers
// in `content` are computed deterministically (lib/social/analytics.ts) and
// injected into the prompt — the model only narrates and recommends, it never
// calculates. One row per generation; the newest row is what the UI shows.
model AiInsight {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        String        @default("weekly_summary")
  content     Json // { summary: string, wins: string[], recommendations: string[] }
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime      @default(now())

  @@index([accountId, createdAt])
}

// Audience demographics for an owned, connected account — one row per
// (dimension, bucket) per capture. Refreshed at most weekly during sync; only
// providers that expose demographics for the authenticated account write rows
// (YouTube Analytics, IG follower insights).
//
// `unit` is load-bearing, not decoration: the original contract was "value is a
// percentage 0-100", but Instagram's online_followers (the source for
// active-hours) returns ABSOLUTE COUNTS. Writing those under the old contract
// renders bars reading 4,200%.
//
// `audience` exists because Instagram exposes follower_demographics,
// engaged_audience_demographics and reached_audience_demographics as three
// different populations. Averaging them together would be meaningless.
model SocialAudienceSnapshot {
  id         String        @id @default(cuid())
  accountId  String
  account    SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedAt DateTime      @default(now())
  dimension  String // age | gender | country | city | language | device | activeHour | activeDay | followerType
  bucket     String // e.g. "18-24", "female", "US", "14" (hour), "mobile"
  value      Float // interpretation depends on `unit`
  unit       String        @default("percent") // percent (0-100) | count
  audience   String        @default("followers") // followers | reached | engaged

  @@index([accountId, dimension, capturedAt])
  @@index([accountId, capturedAt, dimension])
}

// Provider-reported metrics for ONE CALENDAR DAY.
//
// Deliberately NOT an extension of SocialAccountSnapshot. That table holds
// *cumulative lifetime* values captured at sync time, with de-dup logic in
// persistSync and retention keyed to that semantic; windowDelta() reads it and
// assumes a monotonic series. These rows are per-day deltas, restated by the
// provider for ~48h, keyed by calendar date and idempotently upsertable.
// Overloading one table would silently corrupt both readers.
//
// Narrow columns rather than EAV: the metric vocabulary is bounded by
// lib/social/capabilities.ts, so range scans stay index-only and computeKpis is
// one findMany instead of a pivot. extraJson absorbs provider drift without a
// migration.
//
// Volume: ~365 rows/account/year (~1.1k per user at three accounts). Retention
// keeps 400 days of dailies then rolls up to monthly — see pruneTimeSeries.
model SocialDailyMetric {
  id        String        @id @default(cuid())
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // The provider's day as a calendar date, not an instant — this is what makes
  // the unique constraint mean what it should and removes a class of tz bug.
  date      DateTime      @db.Date

  // distribution
  impressions Int?
  reach       Int?
  views       Int?
  plays       Int?

  // audience
  followers       Int? // cumulative mirror, so charts need no join
  followersGained Int?
  followersLost   Int?
  profileViews    Int?
  websiteClicks   Int?

  // interaction
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  totalInteractions Int?
  accountsEngaged   Int?

  // video
  watchTimeSec       Float?
  avgViewDurationSec Float?
  avgViewPercentage  Float?
  ctr                Float?

  // publishing
  postsPublished Int?

  // Anything the provider returned that has no column yet, keyed by MetricKey.
  // Never read without going through capabilities.ts.
  extraJson Json?
  source    String   @default("provider") // provider | derived (monthly rollup)
  fetchedAt DateTime @default(now())

  @@unique([accountId, date])
  @@index([accountId, date])
}

// Daily account-level metric snapshot — powers follower/view growth charts.
model SocialAccountSnapshot {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capturedAt  DateTime      @default(now())
  followers   Int?
  views       Int?
  impressions Int?
  reach       Int?
  engagement  Int?

  @@index([accountId, capturedAt])
}

// A single post/video and its latest analytics for a linked account.
model SocialPost {
  id                String        @id @default(cuid())
  accountId         String
  account           SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerPostId    String
  caption           String?
  thumbnailUrl      String?
  permalink         String?
  mediaType         String? // video | image | reel | short
  publishedAt       DateTime?
  views             Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  reach             Int?
  impressions       Int?
  plays             Int?
  watchTimeSec      Float?
  avgWatchTimeSec   Float?
  avgViewPercentage Float? // completion rate, where the provider reports length
  ctr               Float?
  profileVisits     Int?
  follows           Int?
  linkClicks        Int?
  navigationTaps    Int? // IG stories/reels
  // Scores are PERSISTED, not computed per request: the viral-score cohort is
  // the trailing 90 days of the same media type, which is expensive to rebuild
  // on every page load and non-reproducible as the cohort shifts. Recomputed by
  // the nightly `scores` cron; the *At columns make staleness visible.
  viralScore        Float? // 0-100, deterministic (lib/social/metrics/scores)
  viralScoreAt      DateTime?
  aiScore           Float? // deterministic components; the model only narrates
  aiScoreReason     String? // one-sentence Gemini narration, nullable
  scoredAt          DateTime?
  metricsJson       Json? // full provider payload for future-proofing
  fetchedAt         DateTime      @default(now())

  @@unique([accountId, providerPostId])
  @@index([accountId, publishedAt])
  @@index([accountId, viralScore(sort: Desc)])
}

// A target the user is working toward. `baseline` is captured at creation so
// progress is measured from the starting point rather than from zero.
model SocialGoal {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String? // null = across every connected account
  account   SocialAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metric    String // MetricKey (lib/social/capabilities.ts)
  target    Float
  baseline  Float?
  startAt   DateTime       @default(now())
  dueAt     DateTime
  status    String         @default("active") // active | hit | missed | archived
  hitAt     DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, status])
  @@index([accountId, status])
}

// A saved report definition. `schedule` drives the ?job=reports cron.
model SocialReportConfig {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  accountIds String[]
  period     String // weekly | monthly | quarterly | annual | custom
  sections   String[] // kpis | trends | content | audience | competitors | ai
  format     String // pdf | csv | xlsx
  schedule   String    @default("none") // none | weekly | monthly
  recipients String[]  @default([])
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([schedule, lastRunAt])
}

// One generation of a report. Queued rather than built in the request: an
// annual multi-account PDF with rasterized charts is a 5-20s job that would
// block the event loop for every other request on the instance.
model SocialReportRun {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  configId    String?
  periodStart DateTime
  periodEnd   DateTime
  format      String
  status      String    @default("queued") // queued | running | done | failed
  storageKey  String? // S3 key; downloaded via a presigned URL
  sizeBytes   Int?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// A shareable public report link.
//
// Replaces a bare 7-day JWT that could not be revoked: a link pasted into the
// wrong channel stayed live for a week, and the only kill switch was rotating
// JWT_SECRET (which signs out every user). The token now carries only a `jti`
// and the scope lives here, so the link is revocable and auditable.
model SocialReportLink {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti          String    @unique
  accountIds   String[]
  sections     String[]  @default([])
  expiresAt    DateTime
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
}

// Usage ledger for AI-tool generations — records what a user generated, with
// which model, for how many credits, and at what real provider cost. Phase 1
// only writes rows from image-generator, video-generator, and ai-creator; the
// other tool routes are an explicit fast-follow once they migrate onto
// lib/credits.ts's chargeCredits() (see lib/credits.ts doc comment).
model Generation {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolSlug         String // "image-generator" | "video-generator" | "ai-creator" | ...
  modelId          String? // registry model id, e.g. "flux-2"; null for non-registry tools
  generationType   String // "image" | "video" | "audio" | "utility"
  creditsCost      Int // credits actually charged (pre-refund)
  creditPool       String    @default("standard") // "standard" | "veo3"
  estimatedCostUsd Float? // researched real provider $ cost, for margin analytics
  prompt           String?
  status           String    @default("pending") // "pending" | "completed" | "failed" | "refunded" | "cancelled"
  errorMessage     String?
  progress         Int       @default(0) // 0-100, written by the job's own poll/update path
  cancelledAt      DateTime? // set when the user cancels; job checks this between processing stages
  // Client-supplied key (e.g. one UUID generated per submit click) so a
  // retried/duplicated request can't charge credits twice — chargeCredits
  // looks this up before decrementing and returns the original result if
  // a row with this key already exists.
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([userId, createdAt])
  @@index([modelId])
  @@index([toolSlug, createdAt])
  // Success-rate / failure dashboards group by (status, window).
  @@index([status, createdAt])
}

// API keys for the public API (/api/v1/**). The plaintext key is only ever
// shown once, at creation — this row stores a SHA-256 hash and a short
// prefix (for the user to tell keys apart in the UI), never the key itself.
model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String    @unique
  keyPrefix    String
  scopes       String[]  @default([])
  expiresAt    DateTime? // null = never expires
  requestCount Int       @default(0) // best-effort, incremented alongside lastUsedAt in getApiKeyAuth
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

// Reusable, account-level caption/subtitle style template — the same field
// shape as Clip.subtitleStyleOverride, saved once and applied across
// projects instead of re-styling every clip individually.
model BrandKit {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  fontName       String?
  fontSize       Int?
  baseColor      String?
  highlightColor String?
  outlineColor   String?
  shadowColor    String?
  outlineWidth   Int?
  shadowDepth    Int?
  borderStyle    Int?
  alignment      Int?
  animated       Boolean?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// A user's custom cloned voice (ElevenLabs Instant Voice Cloning). The
// ElevenLabs account itself is shared across every Clipiro user, so this is
// the only place "which voice belongs to which user" is tracked — there's
// no way to ask ElevenLabs that question directly. elevenLabsVoiceId is
// unique because it identifies one real slot in that shared account; two
// rows can never legitimately point at the same voice.
model ClonedVoice {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  elevenLabsVoiceId String   @unique
  name              String
  createdAt         DateTime @default(now())

  @@index([userId])
}

// Immutable log of every admin action for accountability.
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String // e.g. "user.credits_set", "plan.deactivated", "veo3.enabled"
  targetId  String?
  before    String? // JSON snapshot
  after     String? // JSON snapshot
  createdAt DateTime @default(now())

  // The viewer lists newest-first and filters by admin — both were seq scans.
  @@index([createdAt])
  @@index([adminId, createdAt])
}

// ── Rating & Review system ──────────────────────────────────────────────
// Product-level review (G2/Capterra style), one row per user — not
// per-feature. "Feature Used" is a tag validated in the API layer against
// lib/reviews/constants.ts's FEATURE_USED_OPTIONS (string, not a DB enum).
// No soft-delete: delete is a real DELETE — one review per user means a
// re-review after delete is just a fresh insert. Admin "hide" is the
// reversible alternative for moderation.
model Review {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating      Int // 1-5, validated in Zod
  title       String?
  body        String
  featureUsed String // "auto_clips" | "ai_video_editor" | "ai_tools" | "assets" | "billing" | "team_workspaces"

  // Trust signals snapshotted at submission time — a badge earned while
  // eligible must not disappear on a later downgrade/cancellation.
  verifiedCustomer Boolean @default(false)
  tierAtSubmit     String? // TierId snapshot, null if free/trial-not-counted

  // Smart-review-system enrichment (P8) — captured at submission time; no
  // reliable source for company/country exists elsewhere on User, and both
  // are spec'd optional, so free-text at submit is the only honest option.
  wouldRecommend       Boolean? // NPS-style "would you recommend Clipiro?"
  publicDisplayConsent Boolean  @default(true) // governs public listing only, not the aggregate rating (see getReviewSummary)
  company              String?
  country              String?

  // Moderation
  status          String    @default("pending") // "pending" | "published" | "rejected" | "hidden"
  moderatedBy     String? // admin User.id, no relation (AuditLog.adminId convention)
  moderatedAt     DateTime?
  rejectionReason String?
  pinned          Boolean   @default(false) // admin-curated "featured"
  featuredAt      DateTime?

  // Spam heuristics — computed synchronously at submit/edit, no queue
  spamScore Int?
  spamFlags Json?

  // Engagement counters — denormalized for sort/listing; kept in sync in a
  // transaction alongside every vote/report write.
  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)
  reportCount     Int @default(0)

  editedAt  DateTime? // last edit after first publish — re-flips status to "pending"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  attachments ReviewAttachment[]
  votes       ReviewHelpfulVote[]
  reports     ReviewReport[]
  reply       ReviewReply?

  @@index([status, createdAt])
  @@index([status, pinned, createdAt])
  @@index([featureUsed])
  @@index([rating])
}

// Images/short video attached to a review. Mirrors Asset's moderation
// convention exactly instead of inventing a new one.
model ReviewAttachment {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String // denormalized owner, avoids a join for permission checks
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  s3Key          String
  mimeType       String
  kind           String // "image" | "video"
  size           Int
  width          Int?
  height         Int?
  duration       Float?
  thumbnailS3Key String?

  moderationStatus String @default("pending") // "pending" | "clean" | "flagged" | "skipped" | "not_configured"
  moderationLabels Json?

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@index([userId])
}

// One vote per user per review. Manipulation resistance: required auth
// (userId NOT NULL + FK — no anonymous rows), this unique constraint (flip
// via upsert, not duplicate inserts), a self-vote check in the route, and
// per-user + per-IP rate limiting.
model ReviewHelpfulVote {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  value     Int // 1 = helpful, -1 = not helpful
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([userId])
}

// One open report per user per review — the unique constraint doubles as
// request idempotency.
model ReviewReport {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason     String // "spam" | "offensive" | "fake" | "off_topic" | "other"
  details    String?
  status     String    @default("open") // "open" | "reviewed" | "dismissed"
  reviewedBy String? // admin User.id, no relation
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([reviewId, userId])
  @@index([status, createdAt])
  @@index([reviewId])
}

// One official Clipiro-team reply per review — matches G2/Capterra's single
// vendor-response model. adminId plain String, no relation.
model ReviewReply {
  id        String    @id @default(uuid())
  reviewId  String    @unique
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  adminId   String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// Throttle/cooldown state for smart review-prompt triggers. One row per
// user — same shape convention as NotificationPreference (userId @id).
model ReviewPromptState {
  userId                 String    @id
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastPromptedAt         DateTime?
  promptCount            Int       @default(0)
  dismissedAt            DateTime?
  dismissCount           Int       @default(0)
  permanentlyDismissedAt DateTime?
  lastTrigger            String? // "export_complete" | "autoclips_milestone" | "days_active" | "tool_generation_complete" | "billing_success"
  updatedAt              DateTime  @updatedAt
}

// Append-only per-shown-event funnel log — distinct from ReviewPromptState
// (which stays the throttle/cooldown mechanism). Needed because funnel
// analytics (shown -> dismissed vs. converted, broken down by trigger) can't
// be answered by ReviewPromptState's running counters alone. At most one row
// per user is normally "open" (dismissedAt/convertedAt both null) at a time,
// since a new prompt only fires once the throttle allows a prior one to have
// aged out — see lib/reviews/prompt-triggers.ts.
model ReviewPromptEvent {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger          String // PromptTrigger value at fire time
  featureHint      String? // non-authoritative, for analytics grouping + modal prefill only
  shownAt          DateTime  @default(now())
  dismissedAt      DateTime?
  permanentDismiss Boolean   @default(false)
  convertedAt      DateTime?
  reviewId         String?

  @@index([userId, shownAt])
  @@index([trigger, shownAt])
}

// One row per user (like ReviewPromptState) — a drip is inherently bounded
// to 3 sequential stages, so an event-log table would be pointless
// cardinality here. Open/click tracking is folded into these columns rather
// than a separate event table for the same reason.
model ReviewEmailSequence {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerEventAt DateTime // origin timestamp all stage day-offsets are computed from
  sourceTrigger  String // PromptTrigger value that started the sequence

  email1SentAt    DateTime?
  email1OpenedAt  DateTime?
  email1ClickedAt DateTime?
  email2SentAt    DateTime?
  email2OpenedAt  DateTime?
  email2ClickedAt DateTime?
  email3SentAt    DateTime?
  email3OpenedAt  DateTime?
  email3ClickedAt DateTime?

  cancelledAt  DateTime?
  cancelReason String? // "reviewed" | "opted_out"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cancelledAt, triggerEventAt])
}

// Anonymous, aggregate-only daily impression counter for the landing-page
// testimonial section. No cookies, no per-visitor identity — a coarse but
// honest engagement signal without any consent/privacy complexity.
model TestimonialImpression {
  date  String @id // "YYYY-MM-DD"
  count Int    @default(0)
}

// Generic persisted in-app notification — not review-specific in shape,
// even though Reviews is the first caller. Also doubles as the admin
// notification store (userId = the admin's User.id).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // see NotificationType in lib/notify.ts — review_*, admin_review_*, billing_*, autoclip_render_complete|failed
  title     String
  body      String?
  href      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

// Anonymous, aggregate-only first-party marketing analytics. Follows
// TestimonialImpression's "no cookies, no per-visitor identity" stance rather
// than ReviewPromptEvent's per-user log: these events fire for logged-out
// visitors, and a per-row log would either store nothing distinguishing (a
// counter with extra steps and unbounded growth) or require minting a visitor
// identifier we have no consent surface for. One counter row per dimension
// tuple per day.
model MarketingEventDaily {
  id          String   @id @default(uuid())
  date        String // "YYYY-MM-DD" UTC, same convention as TestimonialImpression
  event       String // closed union — see lib/marketing-analytics.ts
  path        String
  placement   String // "listing" | "article_hero" | "mid_article" | "article_footer" | "newsletter"
  // Empty string, NOT null. Postgres unique indexes treat NULLs as distinct, so
  // nullable UTM columns would let duplicate rows accumulate forever and
  // silently defeat the upsert below. Values are normalized server-side to
  // [a-z0-9_-]{0,32} or collapsed to "other" — see app/api/marketing/event.
  utmSource   String   @default("")
  utmMedium   String   @default("")
  utmCampaign String   @default("")
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  // Explicitly mapped: the default generated name for a 7-column unique index
  // exceeds Postgres's 63-char identifier limit and gets silently truncated,
  // which makes the migration SQL hard to write by hand and hard to review.
  @@unique([date, event, path, placement, utmSource, utmMedium, utmCampaign], map: "MarketingEventDaily_dimensions_key")
  @@index([date, event])
  @@index([utmCampaign, date])
}

// Aggregate per-day onboarding funnel counters — the durable sink for
// lib/onboarding-analytics.ts, which was log-only, so the activation funnel
// (welcome_shown -> goal_selected -> tour_completed -> ...) was not queryable.
// One row per (event, UTC day); mirrors MarketingEventDaily's counter shape.
model OnboardingEventDaily {
  id        String   @id @default(uuid())
  date      String // "YYYY-MM-DD" UTC
  event     String // OnboardingEvent — see lib/onboarding-analytics.ts
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([date, event])
}

// Double opt-in newsletter list. Separate from NotificationPreference.newsletter,
// which governs the *logged-in* channel for an existing User — one person can
// legitimately appear in both, so dedupe at send time once a sender exists.
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  status         String    @default("pending") // "pending" | "confirmed" | "unsubscribed"
  // Opaque random token, not a JWT: it has to be revocable and single-use,
  // which a stateless JWT can't be without a DB column anyway — and the column
  // is right here. Doubles as the unsubscribe token.
  token          String    @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  source         String    @default("blog_footer")
  utmCampaign    String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
}

// Core Web Vitals field data, collected first-party via next/web-vitals'
// useReportWebVitals. Deliberately NOT @vercel/speed-insights: this app is
// self-hosted (next.config.ts output: "standalone"), where Speed Insights
// ships a client script and collects nothing.
//
// Stores bucket counts rather than raw samples. Buckets are the official CWV
// thresholds and are what you actually look at; raw values would grow without
// bound and invite storing a per-visitor timeline we have no consent for.
model WebVitalDaily {
  id     String @id @default(uuid())
  date   String // "YYYY-MM-DD" UTC
  metric String // "LCP" | "INP" | "CLS" | "FCP" | "TTFB"
  path   String
  bucket String // "good" | "needs_improvement" | "poor"
  count  Int    @default(0)

  @@unique([date, metric, path, bucket], map: "WebVitalDaily_dimensions_key")
  @@index([date, metric])
}

// Delivery record for every email the product sends.
//
// There was no send history at all: a failed Resend call was a log line and
// nothing else, so "did this user ever get their receipt?" was unanswerable and
// a hard-bouncing address was retried by every cron, forever.
//
// Deliberately NOT a queue. Rows are written after the attempt, so this is an
// audit trail rather than a delivery mechanism — nothing reads it to decide what
// to send next.
model EmailLog {
  id String @id @default(uuid())

  // `recipient`, not `to` — TO is a reserved word in Postgres, and a column that
  // only works while it stays quoted is a trap for the next raw query.
  recipient         String
  templateId        String
  // sent | skipped-optout | dev-logged | failed, then updated by the provider
  // webhook to delivered | bounced | complained.
  status            String
  channel           String? // resend | smtp | dev-console
  // Resend's id. Unique so a webhook can find the row it belongs to, and so a
  // redelivered webhook cannot create a duplicate.
  providerMessageId String? @unique
  userId            String?
  error             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipient, createdAt])
  @@index([templateId, createdAt])
  @@index([status, createdAt])
}

// Addresses we must stop mailing.
//
// Continuing to send to a hard bounce or to someone who pressed "report spam"
// is the fastest way to lose domain reputation, and it was previously
// impossible to stop: every cron just re-read the user table.
//
// Keyed by email rather than userId on purpose — a complaint is about the
// mailbox, and it must keep applying if the address is later attached to a
// different account.
model EmailSuppression {
  email     String   @id
  reason    String // hard_bounce | complaint | manual
  detail    String?
  createdAt DateTime @default(now())

  @@index([reason])
}
