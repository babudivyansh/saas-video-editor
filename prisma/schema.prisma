generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  credits      Int        @default(30)
  role         Role       @default(USER)
  name         String?
  avatarUrl    String?
  planId       String?
  plan         Plan?      @relation(fields: [planId], references: [id])
  createdAt    DateTime   @default(now())
  projects     Project[]
  purchases    Purchase[]
}

model Plan {
  id           String     @id @default(uuid())
  slug         String     @unique
  name         String
  priceInPaise Int
  currency     String     @default("INR")
  credits      Int
  features     String[]   @default([])
  active       Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  users        User[]
  purchases    Purchase[]
}

model Purchase {
  id            String   @id
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String?
  plan          Plan?    @relation(fields: [planId], references: [id])
  amountInPaise Int
  credits       Int
  status        String   @default("captured")
  createdAt     DateTime @default(now())
}

model Project {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  script         String   @default("")
  voiceId        String   @default("")
  musicUrl       String?
  backgroundUrl    String   @default("")
  subtitlesStyle   Json     @default("{}")
  status           String   @default("draft")
  videoUrl         String?
  uploadedVideoUrl String?
  productType      String   @default("split-screen")
  createdAt        DateTime @default(now())
}

model RazorpayEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
}
