{
  "name": "saas-video-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && npm run verify:render-runtime && next build",
    "build:no-db": "next build",
    "postbuild": "node scripts/postbuild.js",
    "start": "node .next/standalone/server.js",
    "lint": "eslint && npm run check:costs",
    "check:costs": "node scripts/check-unverified-costs.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:ffmpeg": "tsx utils/test-ffmpeg.ts",
    "postinstall": "prisma generate && node scripts/install-render-ffmpeg.mjs",
    "check:gpu": "node scripts/check-gpu-service.mjs",
    "verify:render-runtime": "tsx scripts/verify-render-runtime.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1083.0",
